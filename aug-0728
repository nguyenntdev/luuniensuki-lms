rom sqlalchemy import create_engine\n   542\tfrom sqlalchemy import select\n   543\tfrom sqlalchemy.orm import Session\n   544\tfrom sqlalchemy.orm import sessionmaker\n   545\t\n   546\tfrom .models import Base\n   547\tfrom .models import LessonContent\n   548\tfrom .models import Motif\n   549\tfrom .models import MotifCategory\n   550\tfrom .models import MotifRarity\n   551\tfrom .models import QuestionType\n   552\tfrom .models import QuizQuestion\n   553\tfrom .models import Urn\n   554\t\n   555\t\n   556\tURN_ORDER: dict[str, int] = {\n   557\t    \"cao-dinh\": 1,\n   558\t    \"nhan-dinh\": 2,\n   559\t    \"chuong-dinh\": 3,\n   560\t    \"anh-dinh\": 4,\n   561\t    \"nghi-dinh\": 5,\n   562\t    \"thuan-dinh\": 6,\n   563\t    \"tuyen-dinh\": 7,\n   564\t    \"du-dinh\": 8,\n   565\t    \"huyen-dinh\": 9,\n   566\t}\n   567\t\n   568\t\n   569\tdef slugify(value: str) -> str:\n   570\t    value = value.strip().lower()\n   571\t    value = unicodedata.normalize(\"NFKD\", value)\n   572\t    value = \"\".join(ch for ch in value if not unicodedata.combining(ch))\n   573\t    value = value.replace(\"đ\", \"d\")\n   574\t    value = re.sub(r\"[^a-z0-9]+\", \"-\", value)\n   575\t    return value.strip(\"-\")\n   576\t\n   577\t\n   578\tdef extract_json_array_from_markdown(markdown: str) -> list[dict[str, Any]]:\n   579\t    match = re.search(r\"```json\\\\s*(\\\\[.*?\\\\])\\\\s*```\", markdown, flags=re.IGNORECASE | re.DOTALL)\n   580\t    if not match:\n   581\t        raise ValueError(\"No ```json ... ``` array block found in seed markdown file.\")\n   582\t    data = json.loads(match.group(1))\n   583\t    if not isinstance(data, list):\n   584\t        raise ValueError(\"Expected top-level JSON array in seed file.\")\n   585\t    if not all(isinstance(item, dict) for item in data):\n   586\t        raise ValueError(\"Expected JSON array of objects in seed file.\")\n   587\t    return data\n   588\t\n   589\t\n   590\t@dataclass(frozen=True)\n   591\tclass SeedConfig:\n   592\t    database_url: str\n   593\t    seed_file: Path\n   594\t    model_base_url: str\n   595\t\n   596\t\n   597\tdef upsert_urn(session: Session, *, name: str, model_base_url: str) -> Urn:\n   598\t    slug = slugify(name)\n   599\t    display_order = URN_ORDER.get(slug, 0)\n   600\t    is_demo = slug == \"cao-dinh\"\n   601\t    model_url = f\"{model_base_url.rstrip('/')}/{slug}.glb\"\n   602\t\n   603\t    urn = session.execute(select(Urn).where(Urn.slug == slug)).scalar_one_or_none()\n   604\t    if urn is None:\n   605\t        urn = Urn(\n   606\t            slug=slug,\n   607\t            name=name,\n   608\t            model_url=model_url,\n   609\t            display_order=display_order,\n   610\t            is_demo=is_demo,\n   611\t        )\n   612\t        session.add(urn)\n   613\t        session.flush()\n   614\t        return urn\n   615\t\n   616\t    urn.name = name\n   617\t    urn.model_url = model_url\n   618\t    urn.display_order = display_order or urn.display_order\n   619\t    urn.is_demo = is_demo\n   620\t    session.flush()\n   621\t    return urn\n   622\t\n   623\t\n   624\tdef upsert_motif(\n   625\t    session: Session,\n   626\t    *,\n   627\t    urn: Urn,\n   628\t    mesh_name: str,\n   629\t    name_vi: str,\n   630\t    name_en: str | None,\n   631\t    category: MotifCategory,\n   632\t    rarity: MotifRarity,\n   633\t    display_order: int | None,\n   634\t) -> Motif:\n   635\t    motif = session.execute(select(Motif).where(Motif.mesh_name == mesh_name)).scalar_one_or_none()\n   636\t    if motif is None:\n   637\t        motif = Motif(\n   638\t            urn_id=urn.id,\n   639\t            mesh_name=mesh_name,\n   640\t            name=name_vi,\n   641\t            name_en=name_en,\n   642\t            category=category,\n   643\t            rarity=rarity,\n   644\t            pos_x=0.0,\n   645\t            pos_y=0.0,\n   646\t            pos_z=0.0,\n   647\t            bounding_radius=1.0,\n   648\t            is_demo=urn.is_demo,\n   649\t            display_order=display_order,\n   650\t        )\n   651\t        session.add(motif)\n   652\t        session.flush()\n   653\t        return motif\n   654\t\n   655\t    motif.urn_id = urn.id\n   656\t    motif.name = name_vi\n   657\t    motif.name_en = name_en\n   658\t    motif.category = category\n   659\t    motif.rarity = rarity\n   660\t    motif.is_demo = urn.is_demo\n   661\t    motif.display_order = display_order\n   662\t    session.flush()\n   663\t    return motif\n   664\t\n   665\t\n   666\tdef upsert_lesson(session: Session, *, motif: Motif, intro_text: str | None, description: str) -> LessonContent:\n   667\t    lesson = session.execute(select(LessonContent).where(LessonContent.motif_id == motif.id)).scalar_one_or_none()\n   668\t    if lesson is None:\n   669\t        lesson = LessonContent(\n   670\t            motif_id=motif.id,\n   671\t            intro_text=intro_text,\n   672\t            description=description,\n   673\t        )\n   674\t        session.add(lesson)\n   675\t        session.flush()\n   676\t        return lesson\n   677\t\n   678\t    lesson.intro_text = intro_text\n   679\t    lesson.description = description\n   680\t    session.flush()\n   681\t    return lesson\n   682\t\n   683\t\n   684\tdef upsert_quiz_question(\n   685\t    session: Session,\n   686\t    *,\n   687\t    motif: Motif,\n   688\t    question_text: str,\n   689\t    options: list[str] | None,\n   690\t    correct_answer: str,\n   691\t) -> QuizQuestion:\n   692\t    existing = session.execute(\n   693\t        select(QuizQuestion).where(\n   694\t            QuizQuestion.motif_id == motif.id,\n   695\t            QuizQuestion.question_text == question_text,\n   696\t        )\n   697\t    ).scalar_one_or_none()\n   698\t\n   699\t    if existing is None:\n   700\t        existing = QuizQuestion(\n   701\t            motif_id=motif.id,\n   702\t            question_type=QuestionType.multiple_choice,\n   703\t            question_text=question_text,\n   704\t            options=options,\n   705\t            correct_answer=correct_answer,\n   706\t            difficulty=1,\n   707\t            is_active=True,\n   708\t        )\n   709\t        session.add(existing)\n   710\t        session.flush()\n   711\t        return existing\n   712\t\n   713\t    existing.options = options\n   714\t    existing.correct_answer = correct_answer\n   715\t    existing.is_active = True\n   716\t    session.flush()\n   717\t    return existing\n   718\t\n   719\t\n   720\tdef run_seed(config: SeedConfig) -> None:\n   721\t    markdown = config.seed_file.read_text(encoding=\"utf-8\")\n   722\t    items = extract_json_array_from_markdown(markdown)\n   723\t\n   724\t    engine = create_engine(config.database_url, pool_pre_ping=True)\n   725\t    Base.metadata.create_all(engine)\n   726\t    SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)\n   727\t\n   728\t    with SessionLocal() as session:\n   729\t        for idx, item in enumerate(items, start=1):\n   730\t            urn_name = str(item[\"urn_location\"])\n   731\t            urn = upsert_urn(session, name=urn_name, model_base_url=config.model_base_url)\n   732\t\n   733\t            mesh_name = str(item[\"3d_mesh_id\"])\n   734\t            motif = upsert_motif(\n   735\t                session,\n   736\t                urn=urn,\n   737\t                mesh_name=mesh_name,\n   738\t                name_vi=str(item[\"name_vi\"]),\n   739\t                name_en=item.get(\"name_en\"),\n   740\t                category=MotifCategory.thao_moc,\n   741\t                rarity=MotifRarity.common,\n   742\t                display_order=idx,\n   743\t            )\n   744\t\n   745\t            description_short = item.get(\"description_short\")\n   746\t            description_educational = item.get(\"description_educational\") or description_short\n   747\t            if not description_educational:\n   748\t                raise ValueError(f\"Missing description for motif mesh_name={mesh_name!r}\")\n   749\t\n   750\t            upsert_lesson(\n   751\t                session,\n   752\t                motif=motif,\n   753\t                intro_text=description_short,\n   754\t                description=str(description_educational),\n   755\t            )\n   756\t\n   757\t            quiz = item.get(\"quiz_question\")\n   758\t            if isinstance(quiz, dict):\n   759\t                question_text = quiz.get(\"question\")\n   760\t                correct_answer = quiz.get(\"correct_answer\")\n   761\t                if not question_text or not correct_answer:\n   762\t                    raise ValueError(f\"Invalid quiz_question for motif mesh_name={mesh_name!r}\")\n   763\t                options = quiz.get(\"options\")\n   764\t                if options is not None and not isinstance(options, list):\n   765\t                    raise ValueError(f\"Invalid quiz_question.options for motif mesh_name={mesh_name!r}\")\n   766\t                upsert_quiz_question(\n   767\t                    session,\n   768\t                    motif=motif,\n   769\t                    question_text=str(question_text),\n   770\t                    options=options,\n   771\t                    correct_answer=str(correct_answer),\n   772\t                )\n   773\t\n   774\t        session.commit()\n   775\t\n   776\t\n   777\tdef main() -> None:\n   778\t    parser = argparse.ArgumentParser(description=\"Seed Luuniensuki PostgreSQL database from 02_Content_Seed.md\")\n   779\t    parser.add_argument(\n   780\t        \"--seed-file\",\n   781\t        default=\"docs/architecture/02_Content_Seed.md\",\n   782\t        help=\"Path to markdown file containing a ```json [...] ``` block\",\n   783\t    )\n   784\t    args = parser.parse_args()\n   785\t\n   786\t    database_url = os.getenv(\n   787\t        \"DATABASE_URL\",\n   788\t        \"postgresql+psycopg://postgres:postgres@localhost:5432/luuniensuki\",\n   789\t    )\n   790\t    model_base_url = os.getenv(\"MODEL_BASE_URL\", \"/assets/models\")\n   791\t\n   792\t    run_seed(\n   793\t        SeedConfig(\n   794\t            database_url=database_url,\n   795\t            seed_file=Path(args.seed_file),\n   796\t            model_base_url=model_base_url,\n   797\t        )\n   798\t    )\n   799\t\n   800\t\n   801\tif __name__ == \"__main__\":\n   802\t    main()\n   803\t```\n   804\t\n   805\t---\n   806\t\n   807\t## 4) Core APIs — `backend/main.py`\n   808\t\n   809\tRequired endpoints:\n   810\t\n   811\t- `GET /motifs/{urn_name}`: returns all motifs for the urn (accepts either `slug` like `cao-dinh` or exact `name` like `Cao Đỉnh`).\n   812\t- `POST /progress/unlock`: validates a user unlock interaction (mesh match + optional tap position distance check) and upserts `user_progress`.\n   813\t\n   814\t```python\n   815\tfrom __future__ import annotations\n   816\t\n   817\timport logging\n   818\timport math\n   819\tfrom datetime import datetime, timezone\n   820\tfrom typing import Optional\n   821\tfrom uuid import UUID\n   822\t\n   823\tfrom fastapi import Depends\n   824\tfrom fastapi import FastAPI\n   825\tfrom fastapi import HTTPException\n   826\tfrom pydantic import BaseModel\n   827\tfrom pydantic import ConfigDict\n   828\tfrom pydantic import model_validator\n   829\tfrom pydantic_settings import BaseSettings\n   830\tfrom pydantic_settings import SettingsConfigDict\n   831\tfrom sqlalchemy import create_engine\n   832\tfrom sqlalchemy import func\n   833\tfrom sqlalchemy import or_\n   834\tfrom sqlalchemy import select\n   835\tfrom sqlalchemy.exc import IntegrityError\n   836\tfrom sqlalchemy.orm import Session\n   837\tfrom sqlalchemy.orm import sessionmaker\n   838\tfrom sqlalchemy.orm import selectinload\n   839\t\n   840\tfrom .models import Motif\n   841\tfrom .models import UnlockStatus\n   842\tfrom .models import Urn\n   843\tfrom .models import User\n   844\tfrom .models import UserProgress\n   845\t\n   846\t\n   847\tDISCOVERY_XP = 25\n   848\t\n   849\t\n   850\tclass Settings(BaseSettings):\n   851\t    database_url: str = \"postgresql+psycopg://postgres:postgres@db:5432/luuniensuki\"\n   852\t    log_level: str = \"info\"\n   853\t    interaction_tolerance_multiplier: float = 1.25\n   854\t\n   855\t    model_config = SettingsConfigDict(env_file=\".env\", extra=\"ignore\")\n   856\t\n   857\t\n   858\tsettings = Settings()\n   859\tlogging.basicConfig(level=getattr(logging, settings.log_level.upper(), logging.INFO))\n   860\tlogger = logging.getLogger(\"luuniensuki.api\")\n   861\t\n   862\t\n   863\tengine = create_engine(settings.database_url, pool_pre_ping=True)\n   864\tSessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)\n   865\t\n   866\t\n   867\tdef get_db() -> Session:\n   868\t    db = SessionLocal()\n   869\t    try:\n   870\t        yield db\n   871\t    finally:\n   872\t        db.close()\n   873\t\n   874\t\n   875\tapp = FastAPI(title=\"Luuniensuki API\", version=\"0.1.0\")\n   876\t\n   877\t\n   878\tclass UrnOut(BaseModel):\n   879\t    model_config = ConfigDict(from_attributes=True)\n   880\t\n   881\t    id: UUID\n   882\t    slug: str\n   883\t    name: str\n   884\t\n   885\t\n   886\tclass MotifOut(BaseModel):\n   887\t    id: UUID\n   888\t    urn_id: UUID\n   889\t    mesh_name: str\n   890\t    name: str\n   891\t    name_en: Optional[str] = None\n   892\t    category: str\n   893\t    rarity: str\n   894\t    pos_x: float\n   895\t    pos_y: float\n   896\t    pos_z: float\n   897\t    bounding_radius: float\n   898\t    thumbnail_url: Optional[str] = None\n   899\t    silhouette_url: Optional[str] = None\n   900\t    is_demo: bool\n   901\t    display_order: Optional[int] = None\n   902\t    lesson_intro: Optional[str] = None\n   903\t\n   904\t\n   905\tclass MotifsByUrnResponse(BaseModel):\n   906\t    urn: UrnOut\n   907\t    motifs: list[MotifOut]\n   908\t\n   909\t\n   910\t@app.get(\"/motifs/{urn_name}\", response_model=MotifsByUrnResponse)\n   911\tdef get_motifs_by_urn(urn_name: str, db: Session = Depends(get_db)) -> MotifsByUrnResponse:\n   912\t    urn = db.execute(\n   913\t        select(Urn).where(or_(Urn.slug == urn_name, func.lower(Urn.name) == urn_name.lower()))\n   914\t    ).scalar_one_or_none()\n   915\t    if urn is None:\n   916\t        raise HTTPException(status_code=404, detail=\"Urn not found\")\n   917\t\n   918\t    motifs = db.execute(\n   919\t        select(Motif)\n   920\t        .options(selectinload(Motif.lesson))\n   921\t        .where(Motif.urn_id == urn.id, Motif.is_active.is_(True))\n   922\t        .order_by(Motif.display_order.nulls_last(), Motif.name)\n   923\t    ).scalars().all()\n   924\t\n   925\t    return MotifsByUrnResponse(\n   926\t        urn=UrnOut.model_validate(urn),\n   927\t        motifs=[\n   928\t            MotifOut(\n   929\t                id=m.id,\n   930\t                urn_id=m.urn_id,\n   931\t                mesh_name=m.mesh_name,\n   932\t                name=m.name,\n   933\t                name_en=m.name_en,\n   934\t                category=m.category.value,\n   935\t                rarity=m.rarity.value,\n   936\t                pos_x=m.pos_x,\n   937\t                pos_y=m.pos_y,\n   938\t                pos_z=m.pos_z,\n   939\t                bounding_radius=m.bounding_radius,\n   940\t                thumbnail_url=m.thumbnail_url,\n   941\t                silhouette_url=m.silhouette_url,\n   942\t                is_demo=m.is_demo,\n   943\t                display_order=m.display_order,\n   944\t                lesson_intro=(m.lesson.intro_text if m.lesson else None),\n   945\t            )\n   946\t            for m in motifs\n   947\t        ],\n   948\t    )\n   949\t\n   950\t\n   951\tclass TapPosition(BaseModel):\n   952\t    x: float\n   953\t    y: float\n   954\t    z: float\n   955\t\n   956\t\n   957\tclass ProgressUnlockRequest(BaseModel):\n   958\t    user_id: UUID\n   959\t    motif_id: Optional[UUID] = None\n   960\t    mesh_name: Optional[str] = None\n   961\t    tap_position: Optional[TapPosition] = None\n   962\t\n   963\t    @model_validator(mode=\"after\")\n   964\t    def _validate_reference(self) -> \"ProgressUnlockRequest\":\n   965\t        if self.motif_id is None and not self.mesh_name:\n   966\t            raise ValueError(\"Either motif_id or mesh_name is required.\")\n   967\t        return self\n   968\t\n   969\t\n   970\tclass ProgressUnlockResponse(BaseModel):\n   971\t    user_id: UUID\n   972\t    motif_id: UUID\n   973\t    status: str\n   974\t    discovered_at: Optional[datetime] = None\n   975\t    xp_awarded: int\n   976\t    total_xp: int\n   977\t\n   978\t\n   979\t@app.post(\"/progress/unlock\", response_model=ProgressUnlockResponse)\n   980\tdef unlock_progress(payload: ProgressUnlockRequest, db: Session = Depends(get_db)) -> ProgressUnlockResponse:\n   981\t    user = db.get(User, payload.user_id)\n   982\t    if user is None:\n   983\t        raise HTTPException(status_code=404, detail=\"User not found\")\n   984\t\n   985\t    if payload.motif_id is not None:\n   986\t        motif = db.get(Motif, payload.motif_id)\n   987\t    else:\n   988\t        motif = db.execute(select(Motif).where(Motif.mesh_name == payload.mesh_name)).scalar_one_or_none()\n   989\t\n   990\t    if motif is None:\n   991\t        raise HTTPException(status_code=404, detail=\"Motif not found\")\n   992\t\n   993\t    if payload.mesh_name is not None and motif.mesh_name != payload.mesh_name:\n   994\t        raise HTTPException(status_code=400, detail=\"mesh_name does not match motif\")\n   995\t\n   996\t    if user.role.value == \"guest\" and not motif.is_demo:\n   997\t        raise HTTPException(status_code=403, detail=\"Guests can only unlock demo motifs\")\n   998\t\n   999\t    if payload.tap_position is not None and motif.bounding_radius > 0:\n  1000\t        dx 