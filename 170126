    milestone_id: UUID,
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db),
) -> schemas.MilestoneCelebratedOut:
    """Mark a milestone as celebrated."""
    from backend.services.milestones import mark_milestone_celebrated

