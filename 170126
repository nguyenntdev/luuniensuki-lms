    bool isLowRamDevice = false;
    int? totalMemMb;

    if (Platform.isAndroid) {
      final androidInfo = await deviceInfo.androidInfo;
      isLowRamDevice = androidInfo.isLowRamDevice;
      totalMemMb = await _readAndroidTotalMemoryMb();

      debugPrint('[URN_VIEWER] Device: ${androidInfo.manufacturer} ${androidInfo.model}');
      debugPrint('[URN_VIEWER] SDK: ${androidInfo.version.sdkInt}');
      debugPrint('[URN_VIEWER] Low RAM: $isLowRamDevice');
      if (totalMemMb != null) {
        debugPrint('[URN_VIEWER] Total RAM: ${totalMemMb}MB');
      }
    }

    final quality = _chooseModelQuality(
      totalMemMb: totalMemMb,
      isLowRamDevice: isLowRamDevice,
    );

    if (baseUrl.isEmpty) {
      return _ModelSelection(
        url: '',
        quality: quality,
        isLocal: false,
        fallbackUrls: const [],
      );
    }

    if (urnDetail.urn.slug != 'cao-dinh') {
      return _ModelSelection(
        url: baseUrl,
        quality: quality,
        isLocal: false,
        fallbackUrls: const [],
      );
    }

    final url512 = _applyQualitySuffix(baseUrl, ModelQuality.low);
    final url1k = _applyQualitySuffix(baseUrl, ModelQuality.medium);
    final url2k = _applyQualitySuffix(baseUrl, ModelQuality.high);
    final fallbackUrls = switch (quality) {
      ModelQuality.low => [url1k, url2k, baseUrl],
      ModelQuality.medium => [url2k, baseUrl],
      ModelQuality.high => [baseUrl],
    };

    final remoteVariant = switch (quality) {
      ModelQuality.low => url512,
      ModelQuality.medium => url1k,
      ModelQuality.high => url2k,
    };
    debugPrint('[URN_VIEWER] Using remote model for quality: $quality');
    return _ModelSelection(
      url: remoteVariant,
      quality: quality,
      isLocal: false,
      fallbackUrls: fallbackUrls,
