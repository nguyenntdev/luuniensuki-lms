    lesson.status = ContentStatus.review
    lesson.submitted_for_review_at = datetime.utcnow()
    lesson.last_editor_id = current_user.id

    db.commit()
    db.refresh(lesson)

    return AdminLessonOut(
        id=lesson.id,
        motif_id=lesson.motif_id,
        intro_text=lesson.intro_text,
