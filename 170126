export class ApiError extends Error {
  constructor(message, { status, data } = {}) {
    super(message);
    this.name = "ApiError";
    this.status = status;
    this.data = data;
  }
}

export function deriveUsernameFromEmail(email) {
  const localPart = String(email || "").split("@", 1)[0] || "";
  const normalized = localPart
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_]+/g, "_")
    .replace(/_{2,}/g, "_")
    .replace(/^_+|_+$/g, "");

  return normalized || null;
}

export function normalizeUser(user, { fallbackUsername } = {}) {
  if (!user || typeof user !== "object") return user;

  const username =
    user.username ??
    fallbackUsername ??
    deriveUsernameFromEmail(user.email) ??
    null;
  return { ...user, username };
}

let refreshPromise = null;

async function buildApiError(res) {
  let errorMessage = `HTTP ${res.status} ${res.statusText}`;
  let errorData;
  try {
    errorData = await res.json();
    if (errorData?.error?.message) {
      errorMessage = errorData.error.message;
    } else if (errorData?.detail) {
      errorMessage =
        typeof errorData.detail === "string"
          ? errorData.detail
          : JSON.stringify(errorData.detail);
    }
  } catch {
    const text = await res.text().catch(() => "");
    if (text) errorMessage = `${errorMessage}: ${text}`;
  }
  return new ApiError(errorMessage, {
    status: res.status,
    data: errorData,
  });
}

async function refreshSession() {
  if (refreshPromise) return refreshPromise;
  refreshPromise = (async () => {
    const res = await fetch(`${API_BASE_URL}/api/v1/auth/refresh`, {
      method: "POST",
      cache: "no-store",
      credentials: "include",
    });
    if (!res.ok) {
      throw await buildApiError(res);
    }
    return res.json();
  })().finally(() => {
    refreshPromise = null;
  });
  return refreshPromise;
}

export async function apiRequest(
  path,
  { method = "GET", body, skipRefresh, cache = "no-store", keepalive } = {},
) {
  const headers = {};
  if (body) headers["content-type"] = "application/json";

  const res = await fetch(`${API_BASE_URL}${path}`, {
    method,
    headers,
    body: body ? JSON.stringify(body) : undefined,
    cache,
    credentials: "include",
    keepalive,
  });

  if (res.status === 401 && !skipRefresh) {
    const isAuthEndpoint =
      path === "/api/v1/auth/login" ||
      path === "/api/v1/auth/register" ||
      path === "/api/v1/auth/logout" ||
      path === "/api/v1/auth/refresh";
    if (!isAuthEndpoint) {
      await refreshSession();
      return apiRequest(path, { method, body, skipRefresh: true });
    }
  }

  if (!res.ok) {
    throw await buildApiError(res);
  }

  return res.json();
}

