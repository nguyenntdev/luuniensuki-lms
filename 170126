String? _toFullUrl(String? url) {
  if (url == null || url.isEmpty) return null;
  if (url.startsWith('http://') || url.startsWith('https://')) {
    return url;
  }
  // Prepend base URL for relative paths
  return '${ApiConstants.baseUrl}$url';
}

