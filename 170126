                child: _OptionButton(
                  label: optionLabel,
                  text: option,
                  isSelected: false,
                  onTap: () {}, // Disabled
                ),
              ),
            ),
          );
        }

        return Padding(
          padding: const EdgeInsets.only(bottom: 12),
          child: _OptionButton(
            label: optionLabel,
            text: option,
            isSelected: isSelected,
            onTap: () => onAnswerSelected(option),
          ),
        );
      }).toList(),
    );
  }
}

