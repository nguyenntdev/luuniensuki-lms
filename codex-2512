            if urn_discovered_before == 0:
                urns += 1
        if discovered >= 10:
            badge_bonus += _award_badge(db, user=user, badge_slug=BADGE_COLLECTOR_10)
        if discovered >= 50:
            badge_bonus += _award_badge(db, user=user, badge_slug=BADGE_COLLECTOR_50)
        if urns >= 9:
