    icon_url: str,
    category: BadgeCategory,
    xp_bonus: int,
    unlock_criteria: Any,
    is_secret: bool,
) -> Badge:
    badge = session.execute(select(Badge).where(Badge.slug == slug)).scalar_one_or_none()
    if badge is None:
