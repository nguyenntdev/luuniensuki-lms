                UrnExam.urn_id == urn.id,
                UrnExamAttempt.passed.is_(True),
            )
        ).scalar_one()
        if int(passed_before or 0) == 0:
            current_user.total_xp += URN_EXAM_PASS_XP

    badge_bonus = 0
    _update_streak(current_user, now)
    if current_user.current_streak >= 7:
