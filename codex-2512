\t        SAEnum(QuestionType, name=\"question_type\", native_enum=True),\n   416\t        nullable=False,\n   417\t    )\n   418\t    question_text: Mapped[str] = mapped_column(Text, nullable=False)\n   419\t    options: Mapped[Optional[Any]] = mapped_column(JSONB)\n   420\t    correct_answer: Mapped[str] = mapped_column(String(255), nullable=False)\n   421\t    target_mesh_name: Mapped[Optional[str]] = mapped_column(String(100))\n   422\t\n   423\t    difficulty: Mapped[int] = mapped_column(Integer, nullable=False, server_default=text(\"1\"))\n   424\t    explanation: Mapped[Optional[str]] = mapped_column(Text)\n   425\t\n   426\t    is_active: Mapped[bool] = mapped_column(Boolean, nullable=False, server_default=text(\"true\"))\n   427\t    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False, server_default=func.now())\n   428\t\n   429\t    motif: Mapped[Motif] = relationship(back_populates=\"quiz_questions\")\n   430\t\n   431\t\n   432\tclass QuizAttempt(Base):\n   433\t    __tablename__ = \"quiz_attempts\"\n   434\t    __table_args__ = (\n   435\t        Index(\"idx_quiz_attempts_user\", \"user_id\"),\n   436\t        Index(\"idx_quiz_attempts_motif\", \"motif_id\"),\n   437\t    )\n   438\t\n   439\t    id: Mapped[uuid.UUID] = mapped_column(PG_UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)\n   440\t    user_id: Mapped[uuid.UUID] = mapped_column(\n   441\t        PG_UUID(as_uuid=True),\n   442\t        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n   443\t        nullable=False,\n   444\t    )\n   445\t    motif_id: Mapped[uuid.UUID] = mapped_column(\n   446\t        PG_UUID(as_uuid=True),\n   447\t        ForeignKey(\"motifs.id\", ondelete=\"CASCADE\"),\n   448\t        nullable=False,\n   449\t    )\n   450\t\n   451\t    score: Mapped[int] = mapped_column(Integer, nullable=False)\n   452\t    max_score: Mapped[int] = mapped_column(Integer, nullable=False)\n   453\t    percentage: Mapped[int] = mapped_column(Integer, nullable=False)\n   454\t\n   455\t    answers: Mapped[Any] = mapped_column(JSONB, nullable=False)\n   456\t    time_taken_seconds: Mapped[Optional[int]] = mapped_column(Integer)\n   457\t\n   458\t    completed_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False, server_default=func.now())\n   459\t\n   460\t    user: Mapped[User] = relationship(back_populates=\"quiz_attempts\")\n   461\t    motif: Mapped[Motif] = relationship(back_populates=\"quiz_attempts\")\n   462\t\n   463\t\n   464\tclass Badge(Base):\n   465\t    __tablename__ = \"badges\"\n   466\t\n   467\t    id: Mapped[uuid.UUID] = mapped_column(PG_UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)\n   468\t    slug: Mapped[str] = mapped_column(String(100), nullable=False, unique=True)\n   469\t    name: Mapped[str] = mapped_column(String(255), nullable=False)\n   470\t    name_en: Mapped[Optional[str]] = mapped_column(String(255))\n   471\t    description: Mapped[Optional[str]] = mapped_column(Text)\n   472\t    icon_url: Mapped[str] = mapped_column(Text, nullable=False)\n   473\t\n   474\t    category: Mapped[BadgeCategory] = mapped_column(\n   475\t        SAEnum(BadgeCategory, name=\"badge_category\", native_enum=True),\n   476\t        nullable=False,\n   477\t    )\n   478\t    xp_bonus: Mapped[int] = mapped_column(Integer, nullable=False, server_default=text(\"0\"))\n   479\t    unlock_criteria: Mapped[Any] = mapped_column(JSONB, nullable=False)\n   480\t\n   481\t    is_secret: Mapped[bool] = mapped_column(Boolean, nullable=False, server_default=text(\"false\"))\n   482\t    is_active: Mapped[bool] = mapped_column(Boolean, nullable=False, server_default=text(\"true\"))\n   483\t    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False, server_default=func.now())\n   484\t\n   485\t    user_badges: Mapped[list[UserBadge]] = relationship(\n   486\t        back_populates=\"badge\",\n   487\t        cascade=\"all, delete-orphan\",\n   488\t    )\n   489\t\n   490\t\n   491\tclass UserBadge(Base):\n   492\t    __tablename__ = \"user_badges\"\n   493\t    __table_args__ = (\n   494\t        UniqueConstraint(\"user_id\", \"badge_id\", name=\"uq_user_badges_user_badge\"),\n   495\t        Index(\"idx_user_badges_user\", \"user_id\"),\n   496\t    )\n   497\t\n   498\t    id: Mapped[uuid.UUID] = mapped_column(PG_UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)\n   499\t    user_id: Mapped[uuid.UUID] = mapped_column(\n   500\t        PG_UUID(as_uuid=True),\n   501\t        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n   502\t        nullable=False,\n   503\t    )\n   504\t    badge_id: Mapped[uuid.UUID] = mapped_column(\n   505\t        PG_UUID(as_uuid=True),\n   506\t        ForeignKey(\"badges.id\", ondelete=\"CASCADE\"),\n   507\t        nullable=False,\n   508\t    )\n   509\t    earned_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False, server_default=func.now())\n   510\t\n   511\t    user: Mapped[User] = relationship(back_populates=\"user_badges\")\n   512\t    badge: Mapped[Badge] = relationship(back_populates=\"user_badges\")\n   513\t```\n   514\t\n   515\t---\n   516\t\n   517\t## 3) Seeding Script — `backend/seed.py`\n   518\t\n   519\tSeeds from a file or directory (`--seed-path`, default: `data/`) and optionally scans an image directory\n   520\t(`--image-path`, default: `ban-duc-noi/`) to populate `Motif.thumbnail_url` with web paths like\n   521\t`/assets/ban-duc-noi/...`.\n   522\t\n   523\t- `urns`\n   524\t- `motifs`\n   525\t- `lesson_content`\n   526\t- `quiz_questions`\n   527\t  - (optional) `motifs.thumbnail_url` (from `/assets/...`)\n   528\t\n   529\t```python\n   530\tfrom __future__ import annotations\n   531\t\n   532\timport argparse\n   533\timport json\n   534\timport os\n   535\timport re\n   536\timport unicodedata\n   537\tfrom dataclasses import dataclass\n   538\tfrom pathlib import Path\n   539\tfrom typing import Any\n   540\t\n   541\tfrom sqlalchemy import create_engine\n   542\tfrom sqlalchemy import select\n   543\tfrom sqlalchemy.orm import Session\n   544\tfrom sqlalchemy.orm import sessionmaker\n   545\t\n   546\tfrom .models import Base\n   547\tfrom .models import LessonContent\n   548\tfrom .models import Motif\n   549\tfrom .models import MotifCategory\n   550\tfrom .models import MotifRarity\n   551\tfrom .models import QuestionType\n   552\tfrom .models import QuizQuestion\n   553\tfrom .models import Urn\n   554\t\n   555\t\n   556\tURN_ORDER: dict[str, int] = {\n   557\t    \"cao-dinh\": 1,\n   558\t    \"nhan-dinh\": 2,\n   559\t    \"chuong-dinh\": 3,\n   560\t    \"anh-dinh\": 4,\n   561\t    \"nghi-dinh\": 5,\n   562\t    \"thuan-dinh\": 6,\n   563\t    \"tuyen-dinh\": 7,\n   564\t    \"du-dinh\": 8,\n   565\t    \"huyen-dinh\": 9,\n   566\t}\n   567\t\n   568\t\n   569\tdef slugify(value: str) -> str:\n   570\t    value = value.strip().lower()\n   571\t    value = unicodedata.normalize(\"NFKD\", value)\n   572\t    value = \"\".join(ch for ch in value if not unicodedata.combining(ch))\n   573\t    value = value.replace(\"đ\", \"d\")\n   574\t    value = re.sub(r\"[^a-z0-9]+\", \"-\", value)\n   575\t    return value.strip(\"-\")\n   576\t\n   577\t\n   578\tdef extract_json_array_from_markdown(markdown: str) -> list[dict[str, Any]]:\n   579\t    match = re.search(r\"```json\\\\s*(\\\\[.*?\\\\])\\\\s*```\", markdown, flags=re.IGNORECASE | re.DOTALL)\n   580\t    if not match:\n   581\t        raise ValueError(\"No ```json ... ``` array block found in seed markdown file.\")\n   582\t    data = json.loads(match.group(1))\n   583\t    if not isinstance(data, list):\n   584\t        raise ValueError(\"Expected top-level JSON array in seed file.\")\n   585\t    if not all(isinstance(item, dict) for item in data):\n   586\t        raise ValueError(\"Expected JSON array of objects in seed file.\")\n   587\t    return data\n   588\t\n   589\t\n   590\t@dataclass(frozen=True)\n   591\tclass SeedConfig:\n   592\t    database_url: str\n   593\t    seed_file: Path\n   594\t    model_base_url: str\n   595\t\n   596\t\n   597\tdef upsert_urn(session: Session, *, name: str, model_base_url: str) -> Urn:\n   598\t    slug = slugify(name)\n   599\t    display_order = URN_ORDER.get(slug, 0)\n   600\t    is_demo = slug == \"cao-dinh\"\n   601\t    model_url = f\"{model_base_url.rstrip('/')}/{slug}.glb\"\n   602\t\n   603\t    urn = session.execute(select(Urn).where(Urn.slug == slug)).scalar_one_or_none()\n   604\t    if urn is None:\n   605\t        urn = Urn(\n   606\t            slug=slug,\n   607\t            name=name,\n   608\t            model_url=model_url,\n   609\t            display_order=display_order,\n   610\t            is_demo=is_demo,\n   611\t        )\n   612\t        session.add(urn)\n   613\t        session.flush()\n   614\t        return urn\n   615\t\n   616\t    urn.name = name\n   617\t    urn.model_url = model_url\n   618\t    urn.display_order = display_order or urn.display_order\n   619\t    urn.is_demo = is_demo\n   620\t    session.flush()\n   621\t    return urn\n   622\t\n   623\t\n   624\tdef upsert_motif(\n   625\t    session: Session,\n   626\t    *,\n   627\t    urn: Urn,\n   628\t    mesh_name: str,\n   629\t    name_vi: str,\n   630\t    name_en: str | None,\n   631\t    category: MotifCategory,\n   632\t    rarity: MotifRarity,\n   633\t    display_order: int | None,\n   634\t) -> Motif:\n   635\t    motif = session.execute(select(Motif).where(Motif.mesh_name == mesh_name)).scalar_one_or_none()\n   636\t    if motif is None:\n   637\t        motif = Motif(\n   638\t            urn_id=urn.id,\n   639\t            mesh_name=mesh_name,\n   640\t            name=name_vi,\n   641\t            name_en=name_en,\n   642\t            category=category,\n   643\t            rarity=rarity,\n   644\t            pos_x=0.0,\n   645\t            pos_y=0.0,\n   646\t            pos_z=0.0,\n   647\t            bounding_radius=1.0,\n   648\t            is_demo=urn.is_demo,\n   649\t            display_order=display_order,\n   650\t        )\n   651\t        session.add(motif)\n   652\t        session.flush()\n   653\t        return motif\n   654\t\n   655\t    motif.urn_id = urn.id\n   656\t    motif.name = name_vi\n   657\t    motif.name_en = name_en\n   658\t    motif.category = category\n   659\t    motif.rarity = rarity\n   660\t    motif.is_demo = urn.is_demo\n   661\t    motif.display_order = display_order\n   662\t    session.flush()\n   663\t    return motif\n   664\t\n   665\t\n   666\tdef upsert_lesson(session: Session, *, motif: Motif, intro_text: str | None, description: str) -> LessonContent:\n   667\t    lesson = session.execute(select(LessonContent).where(LessonContent.motif_id == motif.id)).scalar_one_or_none()\n   668\t    if lesson is None:\n   669\t        lesson = LessonContent(\n   670\t            motif_id=motif.id,\n   671\t            intro_text=intro_text,\n   672\t            description=description,\n   673\t        )\n   674\t        session.add(lesson)\n   675\t        session.flush()\n   676\t        return lesson\n   677\t\n   678\t    lesson.intro_text = intro_text\n   679\t    lesson.description = description\n   680\t    session.flush()\n   681\t    return lesson\n   682\t\n   683\t\n   684\tdef upsert_quiz_question(\n   685\t    session: Session,\n   686\t    *,\n   687\t    motif: Motif,\n   688\t    question_text: str,\n   689\t    options: list[str] | None,\n   690\t    correct_answer: str,\n   691\t) -> QuizQuestion:\n   692\t    existing = session.execute(\n   693\t        select(QuizQuestion).where(\n   694\t            QuizQuestion.motif_id == motif.id,\n   695\t            QuizQuestion.question_text == question_text,\n   696\t        )\n   697\t    ).scalar_one_or_none()\n   698\t\n   699\t    if existing is None:\n   700\t        existing = QuizQuestion(\n   701\t            motif_id=motif.id,\n   702\t            question_type=QuestionType.multiple_choice,\n   703\t            question_text=question_text,\n   704\t            options=options,\n   705\t            correct_answer=correct_answer,\n   706\t            difficulty=1,\n   707\t            is_active=True,\n   708\t        )\n   709\t        session.add(existing)\n   710\t        session.flush()\n   711\t        return existing\n   712\t\n   713\t    existing.options = options\n   714\t    existing.correct_answer = correct_answer\n   715\t    existing.is_active = True\n   716\t    session.flush()\n   717\t    return existing\n   718\t\n   719\t\n   720\tdef run_seed(config: SeedConfig) -> None:\n   721\t    markdown = config.seed_file.read_text(encoding=\"utf-8\")\n   722\t    items = extract_json_array_from_markdown(markdown)\n   723\t\n   724\t    engine = create_engine(config.database_url, pool_pre_ping=True)\n   725\t    Base.metadata.create_all(engine)\n   726\t    SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)\n   727\t\n   728\t    with SessionLocal() as session:\n   729\t        for idx, item in enumerate(items, start=1):\n   730\t            urn_name = str(item[\"urn_location\"])\n   731\t            urn = upsert_urn(session, name=urn_name, model_base_url=config.model_base_url)\n   732\t\n   733\t            mesh_name = str(item[\"3d_mesh_id\"])\n   734\t            motif = upsert_motif(\n   735\t                session,\n   736\t                urn=urn,\n   737\t                mesh_name=mesh_name,\n   738\t                name_vi=str(item[\"name_vi\"]),\n   739\t                name_en=item.get(\"name_en\"),\n   740\t                category=MotifCategory.thao_moc,\n   741\t                rarity=MotifRarity.common,\n   742\t                display_order=idx,\n   743\t            )\n   744\t\n   745\t            description_short = item.get(\"description_short\")\n   746\t            description_educational = item.get(\"description_educational\") or description_short\n   747\t            if not description