    const motifProgress = progressByMotifId[motifId];
    const isDiscovered =
        motifProgress?.status && motifProgress.status !== "hidden";

    useEffect(() => {
        if (token) fetchMe();
    }, [token, fetchMe]);

    useEffect(() => {
        let cancelled = false;
        async function load() {
            if (!motifId) return;
            if (!token) return;

            // Block access if not discovered
            if (!isDiscovered) {
                setError(
                    "Bạn chưa khám phá họa tiết này. Hãy khám phá trên mô hình 3D trước!",
                );
                return;
            }

            setLoading(true);
            setError(null);
            setResult(null);
            try {
                const [motifRes, quizRes] = await Promise.all([
                    getMotifDetail(motifId),
                    getMotifQuiz({ token, motifId }),
                ]);
                if (cancelled) return;
                setMotif(motifRes);
                setQuiz(quizRes);
                setAnswers({});
                setStartedAt(Date.now());
                setElapsedTime(0);
                setCurrentQuestionIndex(0);
                logAnalyticsEvent({
                    token,
                    name: "quiz_start",
                    payload: {
                        motif_id: motifId,
                        urn_id: motifRes?.urn?.id || null,
                    },
                    path: `/motif/${motifId}/quiz`,
                }).catch(() => null);
            } catch (err) {
                if (!cancelled)
                    setError(err instanceof Error ? err.message : String(err));
            } finally {
                if (!cancelled) setLoading(false);
            }
        }
        load();
        return () => {
            cancelled = true;
        };
    }, [motifId, token, isDiscovered]);

    // Timer effect
    useEffect(() => {
        if (!startedAt || result || submitting) return;

        const interval = setInterval(() => {
            setElapsedTime(Math.floor((Date.now() - startedAt) / 1000));
        }, 1000);

        return () => clearInterval(interval);
    }, [startedAt, result, submitting]);

    // Keyboard navigation
    useEffect(() => {
        if (result || loading || !quiz?.questions?.length) return;

        function handleKeyDown(e) {
            if (e.key === "ArrowRight") {
                if (currentQuestionIndex < quiz.questions.length - 1) {
                    setCurrentQuestionIndex((prev) => prev + 1);
                }
            } else if (e.key === "ArrowLeft") {
                if (currentQuestionIndex > 0) {
                    setCurrentQuestionIndex((prev) => prev - 1);
                }
            }
        }

        window.addEventListener("keydown", handleKeyDown);
        return () => window.removeEventListener("keydown", handleKeyDown);
    }, [currentQuestionIndex, quiz, result, loading]);

    function setAnswer(questionId, answer) {
        setAnswers((prev) => ({ ...prev, [questionId]: answer }));
    }

