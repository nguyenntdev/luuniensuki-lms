                motifId,
                answers: payloadAnswers,
                timeTakenSeconds,
            });
            setResult(res);

            if (res.passed) {
                toast.success(
                    `✅ Chúc mừng! Bạn đã đạt ${res.score}/${res.max_score} điểm!`,
                );
                if (res.xp_awarded > 0) {
                    toast.success(`+${res.xp_awarded} XP`, { icon: "🌟" });
                }
            } else {
                toast.error(`Bạn chưa đạt điểm đậu. Hãy thử lại!`);
            }

            useMotifStore.getState().applyProgressUpdate({
                motifId,
                status: res.status,
                xpAwarded: res.xp_awarded,
                totalXp: res.total_xp,
            });
            await fetchMe();
        } catch (err) {
            const msg = err instanceof Error ? err.message : String(err);
            setError(msg);
            toast.error(`❌ Lỗi: ${msg}`);
        } finally {
            setSubmitting(false);
        }
    }

    function formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = seconds % 60;
        return `${mins.toString().padStart(2, "0")}:${secs.toString().padStart(2, "0")}`;
    }

    if (!token) {
        return (
            <main className="mx-auto max-w-4xl px-6 py-10">
                <div className="rounded-xl border bg-card p-6">
                    <h1 className="text-xl font-display font-semibold">
                        Bài kiểm tra
                    </h1>
                    <p className="mt-2 text-sm text-muted-foreground">
                        Vui lòng đăng nhập để làm bài kiểm tra.
                    </p>
                    <div className="mt-4">
                        <Link
                            href="/login"
                            className="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
                        >
                            Đăng nhập
                        </Link>
                    </div>
                </div>
            </main>
        );
    }

    // Loading State
    if (loading) {
        return (
            <main className="mx-auto max-w-4xl px-6 py-10">
                <div className="text-center text-sm text-muted-foreground">
                    Đang tải bài kiểm tra...
                </div>
            </main>
        );
    }

