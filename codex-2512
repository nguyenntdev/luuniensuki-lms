def coerce_enum(enum_cls: type[EnumT], raw: Any, default: EnumT) -> tuple[EnumT, bool]:
    if isinstance(raw, enum_cls):
        return raw, True

    if raw is None:
        return default, False

    value = raw.strip() if isinstance(raw, str) else str(raw).strip()
