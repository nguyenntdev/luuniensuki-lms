    const localPart = String(email || "").split("@", 1)[0] || "";
    const normalized = localPart
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9_]+/g, "_")
        .replace(/_{2,}/g, "_")
        .replace(/^_+|_+$/g, "");

    return normalized || null;
}

export function normalizeUser(user, { fallbackUsername } = {}) {
    if (!user || typeof user !== "object") return user;

