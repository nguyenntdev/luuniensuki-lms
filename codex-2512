rom .models import User\n   844\tfrom .models import UserProgress\n   845\t\n   846\t\n   847\tDISCOVERY_XP = 25\n   848\t\n   849\t\n   850\tclass Settings(BaseSettings):\n   851\t    database_url: str = \"postgresql+psycopg://postgres:postgres@db:5432/luuniensuki\"\n   852\t    log_level: str = \"info\"\n   853\t    interaction_tolerance_multiplier: float = 1.25\n   854\t\n   855\t    model_config = SettingsConfigDict(env_file=\".env\", extra=\"ignore\")\n   856\t\n   857\t\n   858\tsettings = Settings()\n   859\tlogging.basicConfig(level=getattr(logging, settings.log_level.upper(), logging.INFO))\n   860\tlogger = logging.getLogger(\"luuniensuki.api\")\n   861\t\n   862\t\n   863\tengine = create_engine(settings.database_url, pool_pre_ping=True)\n   864\tSessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)\n   865\t\n   866\t\n   867\tdef get_db() -> Session:\n   868\t    db = SessionLocal()\n   869\t    try:\n   870\t        yield db\n   871\t    finally:\n   872\t        db.close()\n   873\t\n   874\t\n   875\tapp = FastAPI(title=\"Luuniensuki API\", version=\"0.1.0\")\n   876\t\n   877\t\n   878\tclass UrnOut(BaseModel):\n   879\t    model_config = ConfigDict(from_attributes=True)\n   880\t\n   881\t    id: UUID\n   882\t    slug: str\n   883\t    name: str\n   884\t\n   885\t\n   886\tclass MotifOut(BaseModel):\n   887\t    id: UUID\n   888\t    urn_id: UUID\n   889\t    mesh_name: str\n   890\t    name: str\n   891\t    name_en: Optional[str] = None\n   892\t    category: str\n   893\t    rarity: str\n   894\t    pos_x: float\n   895\t    pos_y: float\n   896\t    pos_z: float\n   897\t    bounding_radius: float\n   898\t    thumbnail_url: Optional[str] = None\n   899\t    silhouette_url: Optional[str] = None\n   900\t    is_demo: bool\n   901\t    display_order: Optional[int] = None\n   902\t    lesson_intro: Optional[str] = None\n   903\t\n   904\t\n   905\tclass MotifsByUrnResponse(BaseModel):\n   906\t    urn: UrnOut\n   907\t    motifs: list[MotifOut]\n   908\t\n   909\t\n   910\t@app.get(\"/motifs/{urn_name}\", response_model=MotifsByUrnResponse)\n   911\tdef get_motifs_by_urn(urn_name: str, db: Session = Depends(get_db)) -> MotifsByUrnResponse:\n   912\t    urn = db.execute(\n   913\t        select(Urn).where(or_(Urn.slug == urn_name, func.lower(Urn.name) == urn_name.lower()))\n   914\t    ).scalar_one_or_none()\n   915\t    if urn is None:\n   916\t        raise HTTPException(status_code=404, detail=\"Urn not found\")\n   917\t\n   918\t    motifs = db.execute(\n   919\t        select(Motif)\n   920\t        .options(selectinload(Motif.lesson))\n   921\t        .where(Motif.urn_id == urn.id, Motif.is_active.is_(True))\n   922\t        .order_by(Motif.display_order.nulls_last(), Motif.name)\n   923\t    ).scalars().all()\n   924\t\n   925\t    return MotifsByUrnResponse(\n   926\t        urn=UrnOut.model_validate(urn),\n   927\t        motifs=[\n   928\t            MotifOut(\n   929\t                id=m.id,\n   930\t                urn_id=m.urn_id,\n   931\t                mesh_name=m.mesh_name,\n   932\t                name=m.name,\n   933\t                name_en=m.name_en,\n   934\t                category=m.category.value,\n   935\t                rarity=m.rarity.value,\n   936\t                pos_x=m.pos_x,\n   937\t                pos_y=m.pos_y,\n   938\t                pos_z=m.pos_z,\n   939\t                bounding_radius=m.bounding_radius,\n   940\t                thumbnail_url=m.thumbnail_url,\n   941\t                silhouette_url=m.silhouette_url,\n   942\t                is_demo=m.is_demo,\n   943\t                display_order=m.display_order,\n   944\t                lesson_intro=(m.lesson.intro_text if m.lesson else None),\n   945\t            )\n   946\t            for m in motifs\n   947\t        ],\n   948\t    )\n   949\t\n   950\t\n   951\tclass TapPosition(BaseModel):\n   952\t    x: float\n   953\t    y: float\n   954\t    z: float\n   955\t\n   956\t\n   957\tclass ProgressUnlockRequest(BaseModel):\n   958\t    user_id: UUID\n   959\t    motif_id: Optional[UUID] = None\n   960\t    mesh_name: Optional[str] = None\n   961\t    tap_position: Optional[TapPosition] = None\n   962\t\n   963\t    @model_validator(mode=\"after\")\n   964\t    def _validate_reference(self) -> \"ProgressUnlockRequest\":\n   965\t        if self.motif_id is None and not self.mesh_name:\n   966\t            raise ValueError(\"Either motif_id or mesh_name is required.\")\n   967\t        return self\n   968\t\n   969\t\n   970\tclass ProgressUnlockResponse(BaseModel):\n   971\t    user_id: UUID\n   972\t    motif_id: UUID\n   973\t    status: str\n   974\t    discovered_at: Optional[datetime] = None\n   975\t    xp_awarded: int\n   976\t    total_xp: int\n   977\t\n   978\t\n   979\t@app.post(\"/progress/unlock\", response_model=ProgressUnlockResponse)\n   980\tdef unlock_progress(payload: ProgressUnlockRequest, db: Session = Depends(get_db)) -> ProgressUnlockResponse:\n   981\t    user = db.get(User, payload.user_id)\n   982\t    if user is None:\n   983\t        raise HTTPException(status_code=404, detail=\"User not found\")\n   984\t\n   985\t    if payload.motif_id is not None:\n   986\t        motif = db.get(Motif, payload.motif_id)\n   987\t    else:\n   988\t        motif = db.execute(select(Motif).where(Motif.mesh_name == payload.mesh_name)).scalar_one_or_none()\n   989\t\n   990\t    if motif is None:\n   991\t        raise HTTPException(status_code=404, detail=\"Motif not found\")\n   992\t\n   993\t    if payload.mesh_name is not None and motif.mesh_name != payload.mesh_name:\n   994\t        raise HTTPException(status_code=400, detail=\"mesh_name does not match motif\")\n   995\t\n   996\t    if user.role.value == \"guest\" and not motif.is_demo:\n   997\t        raise HTTPException(status_code=403, detail=\"Guests can only unlock demo motifs\")\n   998\t\n   999\t    if payload.tap_position is not None and motif.bounding_radius > 0:\n  1000\t        dx = payload.tap_position.x - motif.pos_x\n  1001\t        dy = payload.tap_position.y - motif.pos_y\n  1002\t        dz = payload.tap_position.z - motif.pos_z\n  1003\t        distance = math.sqrt(dx * dx + dy * dy + dz * dz)\n  1004\t        allowed = motif.bounding_radius * settings.interaction_tolerance_multiplier\n  1005\t        if distance > allowed:\n  1006\t            raise HTTPException(status_code=400, detail=\"Tap position outside bounding radius\")\n  1007\t\n  1008\t    now = datetime.now(timezone.utc)\n  1009\t\n  1010\t    progress = db.execute(\n  1011\t        select(UserProgress).where(UserProgress.user_id == user.id, UserProgress.motif_id == motif.id)\n  1012\t    ).scalar_one_or_none()\n  1013\t\n  1014\t    xp_awarded = 0\n  1015\t    if progress is None:\n  1016\t        progress = UserProgress(\n  1017\t            user_id=user.id,\n  1018\t            motif_id=motif.id,\n  1019\t            status=UnlockStatus.discovered,\n  1020\t            discovered_at=now,\n  1021\t            xp_earned=DISCOVERY_XP,\n  1022\t        )\n  1023\t        db.add(progress)\n  1024\t        user.total_xp += DISCOVERY_XP\n  1025\t        xp_awarded = DISCOVERY_XP\n  1026\t    else:\n  1027\t        if progress.status == UnlockStatus.hidden:\n  1028\t            progress.status = UnlockStatus.discovered\n  1029\t            progress.discovered_at = progress.discovered_at or now\n  1030\t\n  1031\t        if progress.xp_earned < DISCOVERY_XP:\n  1032\t            delta = DISCOVERY_XP - progress.xp_earned\n  1033\t            progress.xp_earned = DISCOVERY_XP\n  1034\t            user.total_xp += delta\n  1035\t            xp_awarded = delta\n  1036\t\n  1037\t    user.last_active_at = now\n  1038\t\n  1039\t    try:\n  1040\t        db.commit()\n  1041\t    except IntegrityError:\n  1042\t        db.rollback()\n  1043\t        logger.warning(\"IntegrityError during unlock; retrying fetch/update\", exc_info=True)\n  1044\t        progress = db.execute(\n  1045\t            select(UserProgress).where(UserProgress.user_id == user.id, UserProgress.motif_id == motif.id)\n  1046\t        ).scalar_one()\n  1047\t        if progress.status == UnlockStatus.hidden:\n  1048\t            progress.status = UnlockStatus.discovered\n  1049\t            progress.discovered_at = progress.discovered_at or now\n  1050\t        if progress.xp_earned < DISCOVERY_XP:\n  1051\t            delta = DISCOVERY_XP - progress.xp_earned\n  1052\t            progress.xp_earned = DISCOVERY_XP\n  1053\t            user.total_xp += delta\n  1054\t            xp_awarded = max(xp_awarded, delta)\n  1055\t        user.last_active_at = now\n  1056\t        db.commit()\n  1057\t\n  1058\t    return ProgressUnlockResponse(\n  1059\t        user_id=user.id,\n  1060\t        motif_id=motif.id,\n  1061\t        status=progress.status.value,\n  1062\t        discovered_at=progress.discovered_at,\n  1063\t        xp_awarded=xp_awarded,\n  1064\t        total_xp=user.total_xp,\n  1065\t    )\n  1066\t```\n  1067\t\n  1068\t---\n  1069\t\n  1070\t## Quickstart (Local / Server)\n  1071\t\n  1072\t1) Start services:\n  1073\t\n  1074\t```bash\n  1075\tdocker compose up -d --build\n  1076\t```\n  1077\t\n  1078\t2) Seed the DB (from `docs/architecture/02_Content_Seed.md`):\n  1079\t\n  1080\t```bash\n  1081\tdocker compose run --rm api python -m backend.seed\n  1082\t```\n  1083\t\n  1084\t3) Create a user (required for `POST /progress/unlock`):\n  1085\t\n  1086\t```bash\n  1087\tdocker compose exec db psql -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-luuniensuki} \\\n  1088\t  -c \"INSERT INTO users (email, password_hash, display_name) VALUES ('dev@example.com','dev-only','Dev User') RETURNING id;\"\n  1089\t```\n  1090\t\n  1091\t4) Try the APIs:\n  1092\t\n  1093\t```bash\n  1094\tcurl -s http://localhost:8000/motifs/cao-dinh | jq .\n  1095\t```\n  1096\t\n  1097\t```bash\n  1098\tcurl -s -X POST http://localhost:8000/progress/unlock \\\n  1099\t  -H 