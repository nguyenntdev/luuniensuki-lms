import { useEffect, useMemo, useRef, useState } from "react";

import Skeleton from "@/components/Skeleton";
import { getMotifsByUrn, getMyCollection, getMyStreak, getUrns, logAnalyticsEvent } from "@/lib/api";
import { useAuthStore } from "@/stores/authStore";

const STATUS_LABELS = {
  hidden: "Chưa mở",
  discovered: "Đã khám phá",
  learned: "Đã học",
  mastered: "Đã thành thạo",
};

function sortMotifs(a, b) {
  const aOrder = a.display_order ?? Number.MAX_SAFE_INTEGER;
  const bOrder = b.display_order ?? Number.MAX_SAFE_INTEGER;
  if (aOrder !== bOrder) return aOrder - bOrder;
  return String(a.name || "").localeCompare(String(b.name || ""));
}

export default function DashboardPage() {
  const token = useAuthStore((s) => s.accessToken);
  const user = useAuthStore((s) => s.user);
  const fetchMe = useAuthStore((s) => s.fetchMe);

  const [urns, setUrns] = useState([]);
  const [collection, setCollection] = useState(null);
  const [streak, setStreak] = useState(null);
  const [pathMotifs, setPathMotifs] = useState([]);
  const [loading, setLoading] = useState(true);
  const [pathLoading, setPathLoading] = useState(false);
  const [error, setError] = useState(null);

  const hasLoggedRef = useRef(false);

  useEffect(() => {
    if (token && !user) fetchMe();
  }, [token, user, fetchMe]);

  useEffect(() => {
    if (!token) return;
    let cancelled = false;

    async function load() {
      setLoading(true);
      setError(null);
      try {
        const [urnRes, collectionRes, streakRes] = await Promise.all([
          getUrns(),
          getMyCollection({ token }),
          getMyStreak({ token }),
        ]);
        if (cancelled) return;
        setUrns(urnRes || []);
        setCollection(collectionRes || null);
        setStreak(streakRes || null);
      } catch (err) {
        if (!cancelled) setError(err instanceof Error ? err.message : String(err));
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    load();
    return () => {
      cancelled = true;
    };
  }, [token]);

  const startingUrn = useMemo(() => {
    if (!user?.starting_urn_id) return null;
    return urns.find((u) => u.id === user.starting_urn_id) || null;
  }, [urns, user?.starting_urn_id]);

  useEffect(() => {
    if (!token || !startingUrn) return;
    let cancelled = false;

    async function loadPath() {
      setPathLoading(true);
      try {
        const res = await getMotifsByUrn(startingUrn.slug);
        if (cancelled) return;
        const motifs = Array.isArray(res?.motifs) ? res.motifs : [];
        setPathMotifs(motifs.sort(sortMotifs));
      } catch (err) {
        if (!cancelled) setError(err instanceof Error ? err.message : String(err));
      } finally {
        if (!cancelled) setPathLoading(false);
      }
    }

    loadPath();
    return () => {
      cancelled = true;
    };
  }, [startingUrn, token]);

  useEffect(() => {
    if (!token || !user || hasLoggedRef.current) return;
    hasLoggedRef.current = true;
    logAnalyticsEvent({
      token,
      name: "dashboard_view",
      payload: { starting_urn_id: user.starting_urn_id || null },
      path: "/dashboard",
    }).catch(() => null);
  }, [token, user]);

  const statusByMotifId = useMemo(() => {
    const map = {};
    const items = collection?.items || [];
    for (const item of items) {
      if (item?.motif_id) map[item.motif_id] = item.status || "hidden";
    }
    return map;
  }, [collection]);

  const pathMotifsWithStatus = useMemo(() => {
    return pathMotifs.map((motif) => ({
      ...motif,
      status: statusByMotifId[motif.id] || "hidden",
    }));
  }, [pathMotifs, statusByMotifId]);

  const pathCounts = useMemo(() => {
    const counts = { total: 0, discovered: 0, learned: 0, mastered: 0 };
    for (const motif of pathMotifsWithStatus) {
      counts.total += 1;
      if (motif.status === "discovered") counts.discovered += 1;
      if (motif.status === "learned") counts.learned += 1;
      if (motif.status === "mastered") counts.mastered += 1;
    }
    return counts;
  }, [pathMotifsWithStatus]);

  const resumeTarget = useMemo(() => {
    if (!pathMotifsWithStatus.length) return null;
    return (
      pathMotifsWithStatus.find((m) => m.status === "learned") ||
      pathMotifsWithStatus.find((m) => m.status === "discovered") ||
      pathMotifsWithStatus.find((m) => m.status === "hidden")
    );
  }, [pathMotifsWithStatus]);

  const resumeAction = useMemo(() => {
    if (!resumeTarget) return null;
    if (resumeTarget.status === "learned") {
      return {
        title: "Hoàn thành trắc nghiệm",
        description: resumeTarget.name,
        href: `/motif/${resumeTarget.id}/quiz`,
        status: resumeTarget.status,
        motifId: resumeTarget.id,
      };
    }
    if (resumeTarget.status === "discovered") {
      return {
        title: "Tiếp tục bài học",
        description: resumeTarget.name,
        href: `/motif/${resumeTarget.id}`,
        status: resumeTarget.status,
        motifId: resumeTarget.id,
      };
    }
    return {
      title: "Khám phá họa tiết mới",
      description: startingUrn?.name || "Bắt đầu với lộ trình đã chọn",
      href: startingUrn ? `/urns/${startingUrn.slug}` : "/explore",
      status: "hidden",
      motifId: null,
    };
  }, [resumeTarget, startingUrn]);

  const completionPercent = pathCounts.total ? Math.round((pathCounts.mastered / pathCounts.total) * 100) : 0;

  const nextUpList = useMemo(() => {
    return pathMotifsWithStatus.filter((m) => m.status !== "mastered").slice(0, 4);
  }, [pathMotifsWithStatus]);

  function handleResumeClick() {
    if (!token || !resumeAction) return;
    logAnalyticsEvent({
      token,
      name: "resume_click",
      payload: {
        motif_id: resumeAction.motifId,
        status: resumeAction.status,
        starting_urn_id: user?.starting_urn_id || null,
      },
      path: "/dashboard",
    }).catch(() => null);
  }

  if (!token) {
    return (
      <main className="mx-auto max-w-5xl px-6 py-10">
        <div className="rounded-xl border border-border bg-card p-6">
          <h1 className="text-xl font-display font-semibold">Learning Hub</h1>
          <p className="mt-2 text-sm text-muted-foreground">Vui lòng đăng nhập để xem tiến trình học tập.</p>
          <div className="mt-4">
            <Link href="/login" className="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
              Đăng nhập
            </Link>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="mx-auto max-w-6xl px-6 py-10 pb-24">
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 className="text-3xl font-display font-bold text-foreground">Learning Hub</h1>
          <p className="mt-1 text-sm text-muted-foreground">
            Theo dõi tiến trình, tiếp tục lộ trình, và hoàn thành các thử thách tiếp theo.
          </p>
        </div>
        <div className="flex flex-wrap gap-2">
          <Link
            href="/explore"
            className="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted"
          >
            Khám phá Cửu Đỉnh
          </Link>
          <Link
            href="/collection"
            className="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted"
          >
            Bộ sưu tập
          </Link>
        </div>
      </div>

      {error ? (
        <div className="mt-6 rounded-lg border border-destructive/30 bg-destructive/10 p-4 text-sm text-destructive">
          {error}
        </div>
      ) : null}

      <div className="mt-8 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <div className="space-y-6">
          <div className="rounded-2xl border border-border bg-card p-6 shadow-sm">
            {loading ? (
              <div className="space-y-3">
                <Skeleton className="h-5 w-40" />
                <Skeleton className="h-4 w-64" />
                <Skeleton className="h-10 w-32" />
              </div>
            ) : resumeAction ? (
              <>
                <div className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Tiếp tục</div>
                <div className="mt-2 text-xl font-display font-semibold text-foreground">{resumeAction.title}</div>
                <p className="mt-1 text-sm text-muted-foreground">{resumeAction.description}</p>
                <div className="mt-4">
                  <Link
                    href={resumeAction.href}
                    onClick={handleResumeClick}
                    className="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90"
                  >
                    Bắt đầu →
                  </Link>
                </div>
              </>
            ) : (
              <div className="text-sm text-muted-foreground">Chưa có dữ liệu lộ trình.</div>
            )}
          </div>

          <div className="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <div className="flex items-baseline justify-between">
              <div>
                <div className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Lộ trình hiện tại</div>
                <div className="mt-1 text-lg font-display font-semibold text-foreground">
                  {startingUrn?.name || "—"}
                </div>
              </div>
              <div className="text-xs text-muted-foreground">
                {pathCounts.mastered}/{pathCounts.total} hoàn thành
              </div>
            </div>

            <div className="mt-4 h-2 w-full overflow-hidden rounded-full bg-muted">
