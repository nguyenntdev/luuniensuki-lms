    const token = useAuthStore((s) => s.accessToken);
    const user = useAuthStore((s) => s.user);
    const fetchMe = useAuthStore((s) => s.fetchMe);

    const [urns, setUrns] = useState([]);
    const [loading, setLoading] = useState(false);
    const [saving, setSaving] = useState(false);
    const [error, setError] = useState(null);
    const [selectedUrnId, setSelectedUrnId] = useState(null);

    const shouldShow = useMemo(() => {
        if (!token || !user) return false;
        if (isPublicPath(pathname)) return false;
        return !user.starting_urn_id;
    }, [pathname, token, user]);

    useEffect(() => {
        if (token && !user) fetchMe();
    }, [token, user, fetchMe]);

    useEffect(() => {
        if (!shouldShow) return;
        let cancelled = false;

        async function load() {
            setLoading(true);
            setError(null);
            try {
                const res = await getUrns();
                if (!cancelled) {
                    setUrns(res || []);
                    if (!selectedUrnId && res?.length)
                        setSelectedUrnId(res[0].id);
                }
            } catch (err) {
                if (!cancelled)
                    setError(err instanceof Error ? err.message : String(err));
            } finally {
                if (!cancelled) setLoading(false);
            }
        }

        load();
        return () => {
            cancelled = true;
        };
    }, [shouldShow]);

    useEffect(() => {
        if (!shouldShow) return;
        const prevOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        return () => {
            document.body.style.overflow = prevOverflow;
        };
    }, [shouldShow]);

    async function handleConfirm() {
        if (!token || !selectedUrnId) return;
        setSaving(true);
        setError(null);
        try {
            const res = await setStartingPath({ token, urnId: selectedUrnId });
            useAuthStore.setState((state) => ({
                user: {
                    ...(state.user || {}),
                    starting_urn_id: res.starting_urn_id,
                },
            }));
            await logAnalyticsEvent({
                token,
                name: "starting_path_selected",
                payload: {
                    urn_id: res.starting_urn_id,
                    urn_slug: res.starting_urn_slug,
                    source: "client",
                },
                path: pathname || "/",
