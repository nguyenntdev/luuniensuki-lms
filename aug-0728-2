// Individual hotspot with hover state
function Hotspot({ motif, unlocked, position, hotspotRadius, onClickMesh }) {
  const [hovered, setHovered] = useState(false);
  useCursor(hovered);

  // Invisible by default, glow on hover, green when found
  const opacity = unlocked ? 0.4 : hovered ? 0.5 : 0;
  const color = unlocked ? "#10b981" : "#f59e0b";

  return (
    <mesh
      name={motif.mesh_name}
      position={position}
      rotation={[-Math.PI / 2, 0, 0]} // Flat, facing up
      onClick={onClickMesh}
      onPointerOver={(e) => {
        e.stopPropagation();
        setHovered(true);
      }}
      onPointerOut={() => setHovered(false)}
    >
      <circleGeometry args={[hotspotRadius, 32]} />
      <meshStandardMaterial
        color={color}
        transparent
        opacity={opacity}
        emissive={color}
        emissiveIntensity={hovered ? 0.8 : unlocked ? 0.3 : 0}
        side={THREE.DoubleSide}
        depthWrite={false}
      />
    </mesh>
  );
}

function HotspotRing({ motifs, foundByMotifId, onClickMesh, radius, baseY, levelStep }) {
  return (
    <group>
      {motifs.map((motif, idx) => {
        const unlocked = Boolean(foundByMotifId[motif.id]);

        // Use DB positions if available (non-zero), otherwise fallback to circular formula
        const hasDbPosition = motif.pos_x !== 0 || motif.pos_y !== 0 || motif.pos_z !== 0;
        let x, y, z;
        let hotspotRadius = 0.08;

        if (hasDbPosition) {
          x = motif.pos_x;
          y = motif.pos_y;
          z = motif.pos_z;
          hotspotRadius = motif.bounding_radius || 0.08;
        } else {
          // Fallback: circular formula
          const angle = (idx / Math.max(1, motifs.length)) * Math.PI * 2;
          x = Math.cos(angle) * radius;
          z = Math.sin(angle) * radius;
          y = baseY + (idx % 3) * levelStep;
        }

        return (
          <Hotspot
            key={motif.id}
            motif={motif}
            unlocked={unlocked}
            position={[x, y, z]}
            hotspotRadius={hotspotRadius}
            onClickMesh={onClickMesh}
          />
        );
      })}
    </group>
  );
}
