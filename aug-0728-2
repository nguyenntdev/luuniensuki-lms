n.\",\n    97\t        \"icon_url\": \"/assets/badges/first-mastered.svg\",\n    98\t        \"category\": BadgeCategory.achievement,\n    99\t        \"xp_bonus\": 200,\n   100\t        \"unlock_criteria\": {\"type\": \"first_mastered\"},\n   101\t        \"is_secret\": False,\n   102\t    },\n   103\t    {\n   104\t        \"slug\": \"streak-7\",\n   105\t        \"name\": \"Thất Nhật Liên Tiếp\",\n   106\t        \"name_en\": \"7-Day Streak\",\n   107\t        \"description\": \"Duy trì streak 7 ngày liên tiếp.\",\n   108\t        \"icon_url\": \"/assets/badges/streak-7.svg\",\n   109\t        \"category\": BadgeCategory.achievement,\n   110\t        \"xp_bonus\": 150,\n   111\t        \"unlock_criteria\": {\"type\": \"streak\", \"days\": 7},\n   112\t        \"is_secret\": False,\n   113\t    },\n   114\t]\n   115\t\n   116\t\n   117\tdef slugify(value: str) -> str:\n   118\t    value = value.strip().lower()\n   119\t    value = unicodedata.normalize(\"NFKD\", value)\n   120\t    value = \"\".join(ch for ch in value if not unicodedata.combining(ch))\n   121\t    value = value.replace(\"đ\", \"d\")\n   122\t    value = re.sub(r\"[^a-z0-9]+\", \"-\", value)\n   123\t    return value.strip(\"-\")\n   124\t\n   125\t\n   126\tdef extract_json_array_from_markdown(markdown: str) -> list[dict[str, Any]]:\n   127\t    match = re.search(r\"```json\\s*(\\[.*?\\])\\s*```\", markdown, flags=re.IGNORECASE | re.DOTALL)\n   128\t    if not match:\n   129\t        raise ValueError(\"No ```json ... ``` array block found in seed markdown file.\")\n   130\t    data = json.loads(match.group(1))\n   131\t    if not isinstance(data, list):\n   132\t        raise ValueError(\"Expected top-level JSON array in seed file.\")\n   133\t    if not all(isinstance(item, dict) for item in data):\n   134\t        raise ValueError(\"Expected JSON array of objects in seed file.\")\n   135\t    return data\n   136\t\n   137\t\n   138\tdef process_file(file_path: Path) -> list[dict[str, Any]]:\n   139\t    suffix = file_path.suffix.lower()\n   140\t    if suffix == \".json\":\n   141\t        data = json.loads(file_path.read_text(encoding=\"utf-8\"))\n   142\t        if not isinstance(data, list):\n   143\t            raise ValueError(f\"Expected JSON array in {file_path}\")\n   144\t        if not all(isinstance(item, dict) for item in data):\n   145\t            raise ValueError(f\"Expected JSON array of objects in {file_path}\")\n   146\t        return data\n   147\t\n   148\t    if suffix in {\".md\", \".markdown\"}:\n   149\t        markdown = file_path.read_text(encoding=\"utf-8\")\n   150\t        return extract_json_array_from_markdown(markdown)\n   151\t\n   152\t    raise ValueError(f\"Unsupported seed file type: {file_path}\")\n   153\t\n   154\t\n   155\tdef parse_display_order(raw_id: Any) -> int | None:\n   156\t    if not isinstance(raw_id, str) or not raw_id:\n   157\t        return None\n   158\t    match = re.search(r\"_(\\d+)$\", raw_id)\n   159\t    if not match:\n   160\t        return None\n   161\t    try:\n   162\t        return int(match.group(1))\n   163\t    except ValueError:\n   164\t        return None\n   165\t\n   166\t\n   167\tdef slug_variants(value: str) -> list[str]:\n   168\t    variants: list[str] = [slugify(value)]\n   169\t    parts = [p for p in COMPOSITE_NAME_SPLIT_RE.split(value) if p.strip()]\n   170\t    if len(parts) > 1:\n   171\t        part_slugs = [slugify(part) for part in parts]\n   172\t        variants.append(\"-\".join(sorted(part_slugs)))\n   173\t    return list(dict.fromkeys(variants))\n   174\t\n   175\t\n   176\tdef resolve_thumbnail_url(image_map: dict[tuple[str, str], str], *, urn_slug: str, name_vi: str) -> str | None:\n   177\t    target_slug = slugify(name_vi)\n   178\t\n   179\t    alias = IMAGE_SLUG_ALIASES.get((urn_slug, target_slug))\n   180\t    if alias:\n   181\t        url = image_map.get((urn_slug, alias))\n   182\t        if url:\n   183\t            return url\n   184\t\n   185\t    for candidate_slug in slug_variants(name_vi):\n   186\t        url = image_map.get((urn_slug, candidate_slug))\n   187\t        if url:\n   188\t            return url\n   189\t\n   190\t    candidates = [motif_slug for (u, motif_slug) in image_map.keys() if u == urn_slug]\n   191\t    matches = difflib.get_close_matches(target_slug, candidates, n=2, cutoff=0.85)\n   192\t    if not matches:\n   193\t        return None\n   194\t\n   195\t    if len(matches) == 1:\n   196\t        return image_map.get((urn_slug, matches[0]))\n   197\t\n   198\t    ratio_best = difflib.SequenceMatcher(None, target_slug, matches[0]).ratio()\n   199\t    ratio_second = difflib.SequenceMatcher(None, target_slug, matches[1]).ratio()\n   200\t    if ratio_best - ratio_second >= 0.05:\n   201\t        return image_map.get((urn_slug, matches[0]))\n   202\t\n   203\t    return None\n   204\t\n   205\t\n   206\t@dataclass(frozen=True)\n   207\tclass SeedConfig:\n   208\t    database_url: str\n   209\t    seed_path: Path\n   210\t    model_base_url: str\n   211\t\n   212\t\n   213\tdef upsert_urn(session: Session, *, name: str, model_base_url: str, thumbnail_url: str | None = None) -> Urn:\n   214\t    slug = slugify(name)\n   215\t    display_order = URN_ORDER.get(slug, 0)\n   216\t    is_demo = slug == \"cao-dinh\"\n   217\t    model_filename = URN_MODEL_FILENAMES.get(slug)\n   218\t    model_url = f\"{model_base_url.rstrip('/')}/{model_filename}\" if model_filename else \"\"\n   219\t\n   220\t    urn = session.execute(select(Urn).where(Urn.slug == slug)).scalar_one_or_none()\n   221\t    if urn is None:\n   222\t        urn = Urn(\n   223\t            slug=slug,\n   224\t            name=name,\n   225\t            model_url=model_url,\n   226\t            thumbnail_url=thumbnail_url,\n   227\t            display_order=display_order,\n   228\t            is_demo=is_demo,\n   229\t        )\n   230\t        session.add(urn)\n   231\t        session.flush()\n   232\t        return urn\n   233\t\n   234\t    urn.name = name\n   235\t    urn.model_url = model_url\n   236\t    if thumbnail_url:\n   237\t        urn.thumbnail_url = thumbnail_url\n   238\t    urn.display_order = display_order or urn.display_order\n   239\t    urn.is_demo = is_demo\n   240\t    session.flush()\n   241\t    return urn\n   242\t\n   243\t\n   244\tdef upsert_badge(\n   245\t    session: Session,\n   246\t    *,\n   247\t    slug: str,\n   248\t    name: str,\n   249\t    name_en: str | None,\n   250\t    description: str | None,\n   251\t    icon_url: str,\n   252\t    category: BadgeCategory,\n   253\t    xp_bonus: int,\n   254\t    unlock_criteria: Any,\n   255\t    is_secret: bool,\n   256\t) -> Badge:\n   257\t    badge = session.execute(select(Badge).where(Badge.slug == slug)).scalar_one_or_none()\n   258\t    if badge is None:\n   259\t        badge = Badge(\n   260\t            slug=slug,\n   261\t            name=name,\n   262\t            name_en=name_en,\n   263\t            description=description,\n   264\t            icon_url=icon_url,\n   265\t            category=category,\n   266\t            xp_bonus=xp_bonus,\n   267\t            unlock_criteria=unlock_criteria,\n   268\t            is_secret=is_secret,\n   269\t            is_active=True,\n   270\t        )\n   271\t        session.add(badge)\n   272\t        session.flush()\n   273\t        return badge\n   274\t\n   275\t    badge.name = name\n   276\t    badge.name_en = name_en\n   277\t    badge.description = description\n   278\t    badge.icon_url = icon_url\n   279\t    badge.category = category\n   280\t    badge.xp_bonus = xp_bonus\n   281\t    badge.unlock_criteria = unlock_criteria\n   282\t    badge.is_secret = is_secret\n   283\t    badge.is_active = True\n   284\t    session.flush()\n   285\t    return badge\n   286\t\n   287\t\n   288\tdef scan_images(image_path: Path) -> dict[tuple[str, str], str]:\n   289\t    \"\"\"\n   290\t    Scans the image directory and returns a mapping of (urn_slug, motif_slug) -> image_url.\n   291\t    Assumes structure: image_path / Urn_Name / Motif_Name.jpg\n   292\t    \"\"\"\n   293\t    if not image_path.exists():\n   294\t        print(f\"Warning: Image path {image_path} does not exist.\")\n   295\t        return {}\n   296\t\n   297\t    image_extensions = {\".jpg\", \".jpeg\", \".png\", \".webp\", \".gif\"}\n   298\t    base_url = f\"/assets/{image_path.name}\".rstrip(\"/\")\n   299\t\n   300\t    candidates: dict[tuple[str, str], list[str]] = {}\n   301\t    files = sorted(p for p in image_path.rglob(\"*\") if p.is_file() and p.suffix.lower() in image_extensions)\n   302\t    print(f\"Scanning images in {image_path}... ({len(files)} files)\")\n   303\t\n   304\t    for img_file in files:\n   305\t        rel = img_file.relative_to(image_path)\n   306\t        if len(rel.parts) < 2:\n   307\t            continue\n   308\t\n   309\t        urn_dir_name = rel.parts[0]\n   310\t        urn_slug = slugify(urn_dir_name)\n   311\t        motif_slug = slugify(img_file.stem)\n   312\t        key = (urn_slug, motif_slug)\n   313\t        image_url = f\"{base_url}/{quote(rel.as_posix(), safe='/')}\"\n   314\t        candidates.setdefault(key, []).append(image_url)\n   315\t\n   316\t    image_map: dict[tuple[str, str], str] = {}\n   317\t    duplicates = 0\n   318\t    for key, urls in candidates.items():\n   319\t        image_map[key] = urls[0]\n   320\t        if len(urls) > 1:\n   321\t            duplicates += len(urls) - 1\n   322\t            print(f\"Warning: Multiple images match {key}: using {urls[0]} (ignored {len(urls) - 1})\")\n   323\t\n   324\t    print(f\"Found {len(image_map)} image mappings ({duplicates} duplicates).\")\n   325\t    return image_map\n   326\t\n   327\t\n   328\tdef upsert_motif(\n   329\t    session: Session,\n   330\t    *,\n   331\t    urn: Urn,\n   332\t    mesh_name: str,\n   333\t    name_vi: str,\n   334\t    name_en: str | None,\n   335\t    category: MotifCategory,\n   336\t    rarity: MotifRarity,\n   337\t    display_order: int | None,\n   338\t    thumbnail_url: str | None = None,\n   339\t) -> Motif:\n   340\t    motif = session.execute(select(Motif).where(Motif.mesh_name == mesh_name)).scalar_one_or_none()\n   341\t    if motif is None:\n   342\t        motif = Motif(\n   343\t            urn_id=urn.id,\n   344\t            mesh_name=mesh_name,\n   345\t            name=name_vi,\n   346\t            name_en=name_en,\n   347\t            category=category,\n   348\t            rarity=rarity,\n   349\t            pos_x=0.0,\n   350\t            pos_y=0.0,\n   351\t            pos_z=0.0,\n   352\t            bounding_radius=1.0,\n   353\t            is_demo=urn.is_demo,\n   354\t            display_order=display_order,\n   355\t            thumbnail_url=thumbnail_url,\n   356\t        )\n   357\t        session.add(motif)\n   358\t        session.flush()\n   359\t        return motif\n   360\t\n   361\t    motif.urn_id = urn.id\n   362\t    motif.name = name_vi\n   363\t    motif.name_en = name_en\n   364\t    motif.category = category\n   365\t    motif.rarity = rarity\n   366\t    motif.is_demo = urn.is_demo\n   367\t    motif.display_order = display_order\n   368\t    if thumbnail_url:\n   369\t        motif.thumbnail_url = thumbnail_url\n   370\t    session.flush()\n   371\t    return motif\n   372\t\n   373\t\n   374\tdef upsert_lesson(session: Session, *, motif: Motif, intro_text: str | None, description: str) -> LessonContent:\n   375\t    lesson = session.execute(select(LessonContent).where(LessonContent.motif_id == motif.id)).scalar_one_or_none()\n   376\t    if lesson is None:\n   377\t        lesson = LessonContent(\n   378\t            motif_id=motif.id,\n   379\t            intro_text=intro_text,\n   380\t            description=description,\n   381\t        )\n   382\t        session.add(lesson)\n   383\t        session.flush()\n   384\t        return lesson\n   385\t\n   386\t    lesson.intro_text = intro_text\n   387\t    lesson.description = description\n   388\t    session.flush()\n   389\t    return lesson\n   390\t\n   391\t\n   392\tdef upsert_quiz_question(\n   393\t    session: Session,\n   394\t    *,\n   395\t    motif: Motif,\n   396\t    question_text: str,\n   397\t    options: list[str] | None,\n   398\t    correct_answer: str,\n   399\t) -> QuizQuestion:\n   400\t    existing = session.execute(\n   401\t        select(QuizQuestion).where(\n   402\t            QuizQuestion.motif_id == motif.id,\n   403\t            QuizQuestion.question_text == question_text,\n   404\t        )\n   405\t    ).scalar_one_or_none()\n   406\t\n   407\t    if existing is None:\n   408\t        existing = QuizQuestion(\n   409\t            motif_id=motif.id,\n   410\t            question_type=QuestionType.multiple_choice,\n   411\t            question_text=question_text,\n   412\t            options=options,\n   413\t            correct_answer=correct_answer,\n   414\t            difficulty=1,\n   415\t            is_active=True,\n   416\t        )\n   417\t        session.add(existing)\n   418\t        session.flush()\n   419\t        return existing\n   420\t\n   421\t    existing.options = options\n   422\t    existing.correct_answer = correct_answer\n   423\t    existing.is_active = True\n   424\t    session.flush()\n   425\t    return existing\n   426\t\n   427\t\n   428\tdef run_seed(config: SeedConfig, image_path: Path | None = None) -> None:\n   429\t    engine = create_engine(config.database_url, pool_pre_ping=True)\n   430\t    Base.metadata.create_all(engine)\n   431\t    SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)\n   432\t\n   433\t    files_to_process = []\n   434\t    if config.seed_path.is_file():\n   435\t        files_to_process.append(config.seed_path)\n   436\t    elif config.seed_path.is_dir():\n   437\t        files_to_process.extend(sorted(config.seed_path.glob(\"*.json\")))\n   438\t        files_to_process.extend(sorted(config.seed_path.glob(\"