       pos_z=m.pos_z,\n   404\t                bounding_radius=m.bounding_radius,\n   405\t                thumbnail_url=m.thumbnail_url,\n   406\t                silhouette_url=m.silhouette_url,\n   407\t                is_demo=m.is_demo,\n   408\t                display_order=m.display_order,\n   409\t                lesson_intro=(m.lesson.intro_text if m.lesson else None),\n   410\t            )\n   411\t            for m in motifs\n   412\t        ],\n   413\t    )\n   414\t\n   415\t\n   416\tclass UrnListItemOut(BaseModel):\n   417\t    model_config = ConfigDict(from_attributes=True)\n   418\t\n   419\t    id: UUID\n   420\t    slug: str\n   421\t    name: str\n   422\t    model_url: str\n   423\t    thumbnail_url: Optional[str] = None\n   424\t    display_order: int\n   425\t    is_demo: bool\n   426\t    motif_count: int = 0\n   427\t\n   428\t\n   429\t@app.get(\"/api/v1/urns\", response_model=list[UrnListItemOut])\n   430\tdef list_urns(db: Session = Depends(get_db)) -> list[UrnListItemOut]:\n   431\t    motif_counts = (\n   432\t        select(Motif.urn_id, func.count(Motif.id).label(\"motif_count\"))\n   433\t        .where(Motif.is_active.is_(True))\n   434\t        .group_by(Motif.urn_id)\n   435\t        .subquery()\n   436\t    )\n   437\t\n   438\t    rows = db.execute(\n   439\t        select(Urn, func.coalesce(motif_counts.c.motif_count, 0))\n   440\t        .outerjoin(motif_counts, motif_counts.c.urn_id == Urn.id)\n   441\t        .order_by(Urn.display_order, Urn.name)\n   442\t    ).all()\n   443\t\n   444\t    return [\n   445\t        UrnListItemOut(\n   446\t            id=urn.id,\n   447\t            slug=urn.slug,\n   448\t            name=urn.name,\n   449\t            model_url=urn.model_url,\n   450\t            thumbnail_url=urn.thumbnail_url,\n   451\t            display_order=urn.display_order,\n   452\t            is_demo=urn.is_demo,\n   453\t            motif_count=int(motif_count or 0),\n   454\t        )\n   455\t        for urn, motif_count in rows\n   456\t    ]\n   457\t\n   458\t\n   459\tclass UrnDetailOut(BaseModel):\n   460\t    model_config = ConfigDict(from_attributes=True)\n   461\t\n   462\t    id: UUID\n   463\t    slug: str\n   464\t    name: str\n   465\t    name_han: Optional[str] = None\n   466\t    represents: Optional[str] = None\n   467\t    description: Optional[str] = None\n   468\t    model_url: str\n   469\t    thumbnail_url: Optional[str] = None\n   470\t    display_order: int\n   471\t    is_demo: bool\n   472\t\n   473\t\n   474\tclass UrnDetailResponse(BaseModel):\n   475\t    urn: UrnDetailOut\n   476\t    motifs: list[MotifOut]\n   477\t\n   478\t\n   479\t@app.get(\"/api/v1/urns/{urn_slug}\", response_model=UrnDetailResponse)\n   480\tdef get_urn_detail(urn_slug: str, db: Session = Depends(get_db)) -> UrnDetailResponse:\n   481\t    urn = db.execute(select(Urn).where(Urn.slug == urn_slug)).scalar_one_or_none()\n   482\t    if urn is None:\n   483\t        raise HTTPException(status_code=404, detail=\"Urn not found\")\n   484\t\n   485\t    motifs = db.execute(\n   486\t        select(Motif)\n   487\t        .options(selectinload(Motif.lesson))\n   488\t        .where(Motif.urn_id == urn.id, Motif.is_active.is_(True))\n   489\t        .order_by(Motif.display_order.nulls_last(), Motif.name)\n   490\t    ).scalars().all()\n   491\t\n   492\t    return UrnDetailResponse(\n   493\t        urn=UrnDetailOut.model_validate(urn),\n   494\t        motifs=[\n   495\t            MotifOut(\n   496\t                id=m.id,\n   497\t                urn_id=m.urn_id,\n   498\t                mesh_name=m.mesh_name,\n   499\t                name=m.name,\n   500\t                name_en=m.name_en,\n   501\t                category=m.category.value,\n   502\t                rarity=m.rarity.value,\n   503\t                pos_x=m.pos_x,\n   504\t                pos_y=m.pos_y,\n   505\t                pos_z=m.pos_z,\n   506\t                bounding_radius=m.bounding_radius,\n   507\t                thumbnail_url=m.thumbnail_url,\n   508\t                silhouette_url=m.silhouette_url,\n   509\t                is_demo=m.is_demo,\n   510\t                display_order=m.display_order,\n   511\t                lesson_intro=(m.lesson.intro_text if m.lesson else None),\n   512\t            )\n   513\t            for m in motifs\n   514\t        ],\n   515\t    )\n   516\t\n   517\t\n   518\tclass LessonContentOut(BaseModel):\n   519\t    model_config = ConfigDict(from_attributes=True)\n   520\t\n   521\t    intro_text: Optional[str] = None\n   522\t    description: str\n   523\t    historical_context: Optional[str] = None\n   524\t    symbolism: Optional[str] = None\n   525\t    fun_fact: Optional[str] = None\n   526\t    audio_narration_url: Optional[str] = None\n   527\t    additional_images: Optional[Any] = None\n   528\t    video_url: Optional[str] = None\n   529\t\n   530\t\n   531\tclass MotifDetailOut(BaseModel):\n   532\t    id: UUID\n   533\t    urn: UrnOut\n   534\t    mesh_name: str\n   535\t    name: str\n   536\t    name_en: Optional[str] = None\n   537\t    category: str\n   538\t    rarity: str\n   539\t    thumbnail_url: Optional[str] = None\n   540\t    silhouette_url: Optional[str] = None\n   541\t    is_demo: bool\n   542\t    display_order: Optional[int] = None\n   543\t    lesson: Optional[LessonContentOut] = None\n   544\t    quiz_question_count: int = 0\n   545\t\n   546\t\n   547\t@app.get(\"/api/v1/motifs/{motif_id}\", response_model=MotifDetailOut)\n   548\tdef get_motif_detail(motif_id: UUID, db: Session = Depends(get_db)) -> MotifDetailOut:\n   549\t    motif = db.execute(\n   550\t        select(Motif)\n   551\t        .options(selectinload(Motif.urn), selectinload(Motif.lesson), selectinload(Motif.quiz_questions))\n   552\t        .where(Motif.id == motif_id, Motif.is_active.is_(True))\n   553\t    ).scalar_one_or_none()\n   554\t    if motif is None:\n   555\t        raise HTTPException(status_code=404, detail=\"Motif not found\")\n   556\t\n   557\t    lesson_out = LessonContentOut.model_validate(motif.lesson) if motif.lesson else None\n   558\t\n   559\t    return MotifDetailOut(\n   560\t        id=motif.id,\n   561\t        urn=UrnOut.model_validate(motif.urn),\n   562\t        mesh_name=motif.mesh_name,\n   563\t        name=motif.name,\n   564\t        name_en=motif.name_en,\n   565\t        category=motif.category.value,\n   566\t        rarity=motif.rarity.value,\n   567\t        thumbnail_url=motif.thumbnail_url,\n   568\t        silhouette_url=motif.silhouette_url,\n   569\t        is_demo=motif.is_demo,\n   570\t        display_order=motif.display_order,\n   571\t        lesson=lesson_out,\n   572\t        quiz_question_count=len([q for q in motif.quiz_questions if q.is_active]),\n   573\t    )\n   574\t\n   575\t\n   576\tclass LessonCompleteResponse(BaseModel):\n   577\t    user_id: UUID\n   578\t    motif_id: UUID\n   579\t    status: str\n   580\t    lesson_viewed_at: Optional[datetime] = None\n   581\t    learned_at: Optional[datetime] = None\n   582\t    xp_awarded: int\n   583\t    total_xp: int\n   584\t\n   585\t\n   586\t@app.post(\"/api/v1/motifs/{motif_id}/complete-lesson\", response_model=LessonCompleteResponse)\n   587\tdef complete_lesson(\n   588\t    motif_id: UUID,\n   589\t    current_user: User = Depends(get_current_user),\n   590\t    db: Session = Depends(get_db),\n   591\t) -> LessonCompleteResponse:\n   592\t    motif = db.get(Motif, motif_id)\n   593\t    if motif is None or not motif.is_active:\n   594\t        raise HTTPException(status_code=404, detail=\"Motif not found\")\n   595\t\n   596\t    if current_user.role.value == \"guest\" and not motif.is_demo:\n   597\t        raise HTTPException(status_code=403, detail=\"Guests can only learn demo motifs\")\n   598\t\n   599\t    now = datetime.now(timezone.utc)\n   600\t\n   601\t    progress = db.execute(\n   602\t        select(UserProgress).where(UserProgress.user_id == current_user.id, UserProgress.motif_id == motif.id)\n   603\t    ).scalar_one_or_none()\n   604\t    discovered_before = db.execute(\n   605\t        select(func.count(UserProgress.id)).where(\n   606\t            UserProgress.user_id == current_user.id,\n   607\t            UserProgress.status != UnlockStatus.hidden,\n   608\t        )\n   609\t    ).scalar_one()\n   610\t    was_locked = progress is None or progress.status == UnlockStatus.hidden\n   611\t\n   612\t    xp_awarded = 0\n   613\t    target_xp = DISCOVERY_XP + LESSON_XP\n   614\t\n   615\t    if progress is None:\n   616\t        progress = UserProgress(\n   617\t            user_id=current_user.id,\n   618\t            motif_id=motif.id,\n   619\t            status=UnlockStatus.learned,\n   620\t            discovered_at=now,\n   621\t            lesson_viewed_at=now,\n   622\t            learned_at=now,\n   623\t            xp_earned=target_xp,\n   624\t        )\n   625\t        db.add(progress)\n   626\t        current_user.total_xp += target_xp\n   627\t        xp_awarded = target_xp\n   628\t    else:\n   629\t        if progress.status in (UnlockStatus.hidden, UnlockStatus.discovered):\n   630\t            progress.status = UnlockStatus.learned\n   631\t            progress.learned_at = progress.learned_at or now\n   632\t            progress.discovered_at = progress.discovered_at or now\n   633\t\n   634\t        progress.lesson_viewed_at = progress.lesson_viewed_at or now\n   635\t\n   636\t        if progress.xp_earned < target_xp:\n   637\t            delta = target_xp - progress.xp_earned\n   638\t            progress.xp_earned = target_xp\n   639\t            current_user.total_xp += delta\n   640\t            xp_awarded = delta\n   641\t\n   642\t    badge_bonus = 0\n   643\t    _update_streak(current_user, now)\n   644\t    if was_locked and int(discovered_before or 0) == 0:\n   645\t        badge_bonus += _award_badge(db, user=current_user, badge_slug=BADGE_FIRST_DISCOVERY)\n   646\t    if current_user.current_streak >= 7:\n   647\t        badge_bonus += _award_badge(db, user=current_user, badge_slug=BADGE_STREAK_7)\n   648\t\n   649\t    current_user.last_active_at = now\n   650\t\n   651\t    try:\n   652\t        db.commit()\n   653\t    except IntegrityError:\n   654\t        db.rollback()\n   655\t        logger.warning(\"IntegrityError during complete-lesson; retrying fetch/update\", exc_info=True)\n   656\t        badge_bonus = 0\n   657\t        discovered_before = db.execute(\n   658\t            select(func.count(UserProgress.id)).where(\n   659\t                UserProgress.user_id == current_user.id,\n   660\t                UserProgress.status != UnlockStatus.hidden,\n   661\t            )\n   662\t        ).scalar_one()\n   663\t        progress = db.execute(\n   664\t            select(UserProgress).where(UserProgress.user_id == current_user.id, UserProgress.motif_id == motif.id)\n   665\t        ).scalar_one()\n   666\t        was_locked = progress.status == UnlockStatus.hidden\n   667\t        if progress.status in (UnlockStatus.hidden, UnlockStatus.discovered):\n   668\t            progress.status = UnlockStatus.learned\n   669\t            progress.learned_at = progress.learned_at or now\n   670\t            progress.discovered_at = progress.discovered_at or now\n   671\t        progress.lesson_viewed_at = progress.lesson_viewed_at or now\n   672\t        if progress.xp_earned < target_xp:\n   673\t            delta = target_xp - progress.xp_earned\n   674\t            progress.xp_earned = target_xp\n   675\t            current_user.total_xp += delta\n   676\t            xp_awarded = max(xp_awarded, delta)\n   677\t        _update_streak(current_user, now)\n   678\t        if was_locked and int(discovered_before or 0) == 0:\n   679\t            badge_bonus += _award_badge(db, user=current_user, badge_slug=BADGE_FIRST_DISCOVERY)\n   680\t        if current_user.current_streak >= 7:\n   681\t            badge_bonus += _award_badge(db, user=current_user, badge_slug=BADGE_STREAK_7)\n   682\t        current_user.last_active_at = now\n   683\t        db.commit()\n   684\t\n   685\t    return LessonCompleteResponse(\n   686\t        user_id=current_user.id,\n   687\t        motif_id=motif.id,\n   688\t        status=progress.status.value,\n   689\t        lesson_viewed_at=progress.lesson_viewed_at,\n   690\t        learned_at=progress.learned_at,\n   691\t        xp_awarded=xp_awarded + badge_bonus,\n   692\t        total_xp=current_user.total_xp,\n   693\t    )\n   694\t\n   695\t\n   696\tclass TapPosition(BaseModel):\n   697\t    x: float\n   698\t    y: float\n   699\t    z: float\n   700\t\n   701\t\n   702\tclass ProgressUnlockRequest(BaseModel):\n   703\t    motif_id: Optional[UUID] = None\n   704\t    mesh_name: Optional[str] = None\n   705\t    tap_position: Optional[TapPosition] = None\n   706\t\n   707\t    @model_validator(mode=\"after\")\n   708\t    def _validate_reference(self) -> \"ProgressUnlockRequest\":\n   709\t        if self.motif_id is None and not self.mesh_name:\n   710\t            raise ValueError(\"Either motif_id or mesh_name is required.\")\n   711\t        return self\n   712\t\n   713\t\n   714\tclass ProgressUnlockResponse(BaseModel):\n   715\t    user_id: UUID\n   716\t    motif_id: UUID\n   717\t    status: str\n   718\t    discovered_at: Optional[datetime] = None\n   719\t    xp_awarded: int\n   720\t    total_xp: int\n   721\t\n   722\t\n   723\t@app.post(\"/progress/unlock\", response_model=ProgressUnlockResponse)\n   724\tdef unlock_progress(\n   725\t    payload: ProgressUnlockRequest,\n   726\t    current_user: User = Depends(get_current_user),\n   727\t    db: Session = Depends(get_db),\n   728\t) -> ProgressUnlockResponse:\n   729\t    user = current_user\n   730\t\n   731\t    if payload.motif_id is not None:\n   732\t        motif = db.get(Motif, payload.motif_id)\n   733\t    else:\n   734\t        motif = db.execute(select(Motif).where(Motif.mesh_name == payload.mes