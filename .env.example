## Janus WebRTC Gateway (live-room-rust-janus-migration)
# Media plane for the native Rust live control plane. Coexists with LiveKit
# behind LIVE_MEDIA_BACKEND during the phased cutover (set to "janus" to use it).
LIVE_MEDIA_BACKEND=livekit
# Internal (docker network) Janus endpoints — never exposed publicly.
JANUS_WS_URL=ws://janus-gateway:8188
JANUS_HTTP_URL=http://janus-gateway:8088/janus
JANUS_ADMIN_URL=http://janus-gateway:7088/admin
# Public WS path the browser connects to (reverse-proxied).
JANUS_PUBLIC_WS_URL=wss://lms.histolab.icu/janus
# Server-side secrets — set strong values in prod, never commit real values.
JANUS_ADMIN_SECRET=replace_with_strong_janus_admin_secret
JANUS_API_SECRET=replace_with_strong_janus_api_secret
# Shared service token for Rust<->Python AI worker internal calls (distinct from user JWTs).
LIVE_INTERNAL_TOKEN=replace_with_strong_internal_token
# Join-credential lifetime + reconnect grace.
LIVE_JOIN_CREDENTIAL_TTL_MINUTES=30
LIVE_RECONNECT_GRACE_SECONDS=20
# coturn REST API static-auth-secret for time-limited ICE/TURN credentials.
TURN_STATIC_AUTH_SECRET=

# Demo live classroom provisioning (optional)
DEMO_LIVE_ENTRY_ENABLED=false
DEMO_LIVE_ENTRY_KEY=
DEMO_LIVE_TEACHER_EMAIL=live.teacher@histolab.icu
DEMO_LIVE_TEACHER_PASSWORD=LiveTeacher@2026
DEMO_LIVE_TEACHER_NAME=Live Demo Teacher
DEMO_LIVE_CLASS_NAME=AI Teacher 3D Demo Class
DEMO_LIVE_SESSION_TITLE=AI Teacher 3D Live Session
DEMO_LIVE_MAX_STUDENTS=60
DEMO_LIVE_BASE_URL=https://lms.histolab.icu

## Optional
LOG_LEVEL=info
SENTRY_DSN=

## AI Teacher Worker
AI_TEACHER_WORKER_INTERVAL_SECONDS=1.0
AI_TEACHER_WORKER_MAX_SESSIONS=200
