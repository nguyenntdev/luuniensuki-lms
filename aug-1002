 99\t    \"fun_fact\": \"Xoài được mệnh danh là 'Vua của các loại trái cây' ở nhiều nơi trên thế giới. Một cây xoài cổ thụ có thể sống hàng trăm năm và vẫn cho quả. Lá xoài non cũng được dùng như một loại rau ăn kèm ở một số vùng miền Tây.\",\n   100\t    \"is_ai_generated\": true,\n   101\t    \"quiz_questions\": [\n   102\t      {\n   103\t        \"type\": \"multiple_choice\",\n   104\t        \"question\": \"Am La là tên gọi khác của loại trái cây nào?\",\n   105\t        \"options\": [\n   106\t          \"A. Trái Mít\",\n   107\t          \"B. Trái Xoài\",\n   108\t          \"C. Trái Ổi\",\n   109\t          \"D. Trái Cam\"\n   110\t        ],\n   111\t        \"correct_answer\": \"B. Trái Xoài\",\n   112\t        \"difficulty\": 1,\n   113\t        \"explanation\": \"Am La là tên chữ Hán chỉ cây Xoài.\"\n   114\t      },\n   115\t      {\n   116\t        \"type\": \"true_false\",\n   117\t        \"question\": \"Xoài là loại cây ôn đới, chỉ mọc ở xứ lạnh.\",\n   118\t        \"options\": [\n   119\t          \"Đúng\",\n   120\t          \"Sai\"\n   121\t        ],\n   122\t        \"correct_answer\": \"Sai\",\n   123\t        \"difficulty\": 1,\n   124\t        \"explanation\": \"Xoài là cây ăn quả nhiệt đới điển hình, thích hợp với khí hậu nóng ẩm.\"\n   125\t      }\n   126\t    ],\n   127\t    \"3d_mesh_id\": \"mesh_urn_chuong_dinh_03_v1\",\n   128\t    \"thumbnail_url\": \"/assets/ban-duc-noi/CHƯƠNG%20DỈNH/AM LA.jpg\"\n   129\t  },\n   130\t  {\n   131\t    \"id\": \"urn_chuong_dinh_04\",\n   132\t    \"name_vi\": \"Đậu Khấu\",\n   133\t    \"name_en\": \"Cardamom\",\n   134\t    \"urn_location\": \"Chương Đỉnh\",\n   135\t    \"category\": \"thao_moc\",\n   136\t    \"rarity\": \"rare\",\n   137\t    \"description_short\": \"Đậu khấu - vị thuốc quý và gia vị thơm nồng từ rừng già.\",\n   138\t    \"description_educational\": \"Đậu Khấu (thường chỉ Bạch đậu khấu hoặc Nhục đậu khấu) là một loài cây dược liệu và gia vị quý. Quả đậu khấu có mùi thơm cay nồng, ấm áp, được dùng để chữa các bệnh về tiêu hóa, lạnh bụng và làm gia vị cho các món ăn cao cấp. Trên Chương Đỉnh, hình ảnh cây đậu khấu nhắc nhở về sự phong phú của nguồn dược liệu nước nhà. Trong đông y, đậu khấu được ví như một vị tướng quân có khả năng 'thông quan khai khiếu', đánh tan hàn khí. Loài cây này thường mọc dưới tán rừng già ẩm ướt, việc thu hái cũng không dễ dàng.\",\n   139\t    \"historical_context\": \"Đậu khấu từng là mặt hàng cống nạp và xuất khẩu quan trọng. Các triều đại phong kiến rất chú trọng việc thu mua và dự trữ các loại hương liệu, dược liệu quý như đậu khấu, quế, hồi.\",\n   140\t    \"symbolism\": \"Đậu khấu tượng trưng cho sự ấm áp, chữa lành và tinh túy ẩn giấu (hạt thơm nằm sâu trong vỏ quả). Nó còn biểu thị cho sự chăm sóc sức khỏe và sự trường thọ.\",\n   141\t    \"fun_fact\": \"Trong văn học cổ, 'tuổi đậu khấu' dùng để chỉ các cô gái trẻ khoảng 13-14 tuổi (tương lai rực rỡ như hoa đậu khấu đầu cành). Đậu khấu còn là một thành phần không thể thiếu trong món Phở truyền thống để tạo nên hương vị đặc trưng.\",\n   142\t    \"is_ai_generated\": true,\n   143\t    \"quiz_questions\": [\n   144\t      {\n   145\t        \"type\": \"multiple_choice\",\n   146\t        \"question\": \"Đậu khấu chủ yếu được sử dụng để làm gì?\",\n   147\t        \"options\": [\n   148\t          \"A. Làm thuốc và gia vị\",\n   149\t          \"B. Làm đồ gỗ\",\n   150\t          \"C. Dệt vải\",\n   151\t          \"D. Làm giấy\"\n   152\t        ],\n   153\t        \"correct_answer\": \"A. Làm thuốc và gia vị\",\n   154\t        \"difficulty\": 1,\n   155\t        \"explanation\": \"Đậu khấu nổi tiếng với tính ấm, mùi thơm, dùng làm thuốc chữa bệnh tiêu hóa và gia vị nấu ăn.\"\n   156\t      },\n   157\t      {\n   158\t        \"type\": \"multiple_choice\",\n   159\t        \"question\": \"Thuật ngữ 'tuổi đậu khấu' dùng để chỉ ai?\",\n   160\t        \"options\": [\n   161\t          \"A. Người già trên 80 tuổi\",\n   162\t          \"B. Thiếu nữ 13-14 