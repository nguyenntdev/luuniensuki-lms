{
  "id": "urn_cao_dinh_02",
  "name_vi": "Long",
  "name_en": "Dragon",
  "urn_location": "Cao Đỉnh",
  "category": "linh_thu",
  "rarity": "legendary",

  "description_short": "Con rồng - biểu tượng tối cao của quyền lực hoàng đế và sức mạnh thiên nhiên.",
  "description_educational": "Rồng là biểu tượng linh thiêng nhất trong văn hóa Việt Nam và Đông Á, đại diện cho quyền lực tối cao của hoàng đế. Trên Cao Đỉnh, hình ảnh rồng được chạm khắc tinh xảo với thân uốn lượn, vảy rồng sắc nét, và móng vuốt mạnh mẽ. Trong triết học phương Đông, rồng tượng trưng cho sự kết hợp giữa trời và đất, giữa âm và dương. Vua Gia Long đã chọn hình ảnh rồng cho Cao Đỉnh để khẳng định vị thế của triều đại Nguyễn là chính thống kế thừa các triều đại trước.",
