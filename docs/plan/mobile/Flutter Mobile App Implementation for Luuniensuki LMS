/// Auth state notifier that manages authentication state.
/// Handles login, registration, logout, and session management.
@riverpod
class AuthNotifier extends _$AuthNotifier {
  @override
  AuthState build() {
    // Start with initial state and check auth status
    _checkAuthStatus();
    return const AuthState.initial();
  }

  AuthRepository get _repository => ref.read(authRepositoryProvider);

  /// Check initial authentication status
  Future<void> _checkAuthStatus() async {
    try {
      final isLoggedIn = await _repository.isLoggedIn();

      if (!isLoggedIn) {
        state = const AuthState.unauthenticated();
        return;
      }

      // Try to get current user
      final result = await _repository.getCurrentUser();

      result.fold(
        (failure) {
          debugPrint('Auth check failed: ${failure.message}');
          state = const AuthState.unauthenticated();
        },
        (user) {
          state = AuthState.authenticated(user: user);
        },
      );
    } catch (e) {
      debugPrint('Auth check error: $e');
      state = const AuthState.unauthenticated();
    }
  }

  /// Login with email and password
  Future<void> login({
    required String email,
    required String password,
  }) async {
    state = const AuthState.loading();

    final result = await _repository.login(
      email: email,
      password: password,
    );

    result.fold(
      (failure) {
        state = AuthState.error(message: _getErrorMessage(failure));
      },
      (user) {
        state = AuthState.authenticated(user: user);
      },
    );
  }

  /// Register a new user
  Future<void> register({
    required String email,
    required String password,
    required String displayName,
  }) async {
    state = const AuthState.loading();

    final result = await _repository.register(
      email: email,
      password: password,
      displayName: displayName,
    );

    result.fold(
      (failure) {
        state = AuthState.error(message: _getErrorMessage(failure));
      },
      (user) {
        state = AuthState.authenticated(user: user);
      },
    );
  }

  /// Logout current user
  Future<void> logout() async {
    state = const AuthState.loading();

    await _repository.logout();
    state = const AuthState.unauthenticated();
  }

  /// Refresh user data from server
  Future<void> refreshUser() async {
    if (!state.isAuthenticated) return;

    final result = await _repository.getCurrentUser();

    result.fold(
      (failure) {
        // If session expired, logout
        if (failure is AuthFailure) {
          state = const AuthState.unauthenticated();
        }
        // Otherwise keep current state
      },
      (user) {
        state = AuthState.authenticated(user: user);
      },
    );
  }

  /// Update user profile
  Future<bool> updateProfile({
    String? displayName,
    String? username,
    String? avatarUrl,
    bool? isProfilePublic,
  }) async {
    final currentUser = state.user;
    if (currentUser == null) return false;

    final result = await _repository.updateProfile(
      displayName: displayName,
      username: username,
      avatarUrl: avatarUrl,
      isProfilePublic: isProfilePublic,
    );

    return result.fold(
      (failure) => false,
      (user) {
        state = AuthState.authenticated(user: user);
        return true;
      },
    );
  }

  /// Change user password
  Future<Either<String, void>> changePassword({
    required String currentPassword,
    required String newPassword,
  }) async {
    final result = await _repository.changePassword(
      currentPassword: currentPassword,
      newPassword: newPassword,
    );

    return result.fold(
      (failure) => Left(_getErrorMessage(failure)),
      (_) => const Right(null),
    );
  }

  /// Use a streak freeze
  Future<bool> useStreakFreeze() async {
    final result = await _repository.useStreakFreeze();

    return result.fold(
      (failure) => false,
      (user) {
        state = AuthState.authenticated(user: user);
        return true;
      },
    );
  }

  /// Clear error state and return to unauthenticated
  void clearError() {
    if (state is AuthStateError) {
      state = const AuthState.unauthenticated();
    }
  }

  /// Get user-friendly error message from failure
  String _getErrorMessage(Failure failure) {
    if (failure is AuthFailure) {
      switch (failure.code) {
        case 'INVALID_CREDENTIALS':
          return 'Email hoặc mật khẩu không đúng';
        case 'SESSION_EXPIRED':
          return 'Phiên đăng nhập đã hết hạn';
        case 'EMAIL_EXISTS':
          return 'Email đã được đăng ký';
        case 'ACCOUNT_DISABLED':
          return 'Tài khoản đã bị vô hiệu hóa';
        default:
          return failure.message;
      }
    }

    if (failure is NetworkFailure) {
      return 'Không có kết nối mạng. Vui lòng kiểm tra lại.';
    }

    if (failure is ValidationFailure) {
      // Return first field error or general message
      for (final errors in failure.fieldErrors.values) {
        if (errors.isNotEmpty) {
          return errors.first;
        }
      }
      return failure.message;
    }

    if (failure is ServerFailure) {
      if (failure.statusCode == 429) {
        return 'Quá nhiều yêu cầu. Vui lòng thử lại sau.';
      }
      return failure.message;
    }

    return failure.message;
  }
}

