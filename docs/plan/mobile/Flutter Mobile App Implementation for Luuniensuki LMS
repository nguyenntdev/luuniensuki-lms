  Widget _buildProgressStepper() {
    final steps = [
      _ProgressStep(
        label: 'Khám Phá',
        xp: 25,
        icon: Icons.explore,
        isCompleted: motif.isDiscovered,
        isCurrent: motif.status == MotifStatus.discovered,
      ),
      _ProgressStep(
        label: 'Bài Học',
        xp: 50,
        icon: Icons.school,
        isCompleted: motif.isLearned,
        isCurrent: motif.status == MotifStatus.learned,
      ),
      _ProgressStep(
        label: 'Trắc Nghiệm',
        xp: 75,
        icon: Icons.quiz,
        isCompleted: motif.isMastered,
        isCurrent: false,
      ),
    ];

    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.grey[50],
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: Colors.grey[200]!),
      ),
      child: Row(
        children: [
          for (int i = 0; i < steps.length; i++) ...[
            Expanded(child: _buildStepItem(steps[i])),
            if (i < steps.length - 1)
              Expanded(
                child: Container(
                  height: 2,
                  color: steps[i].isCompleted
                      ? AppColors.statusDiscovered
                      : Colors.grey[300],
                ),
              ),
          ],
        ],
      ),
    );
  }

  Widget _buildStepItem(_ProgressStep step) {
    Color circleColor;
    Color iconColor;

    if (step.isCompleted) {
      circleColor = AppColors.statusDiscovered;
      iconColor = Colors.white;
    } else if (step.isCurrent) {
      circleColor = AppColors.primary;
      iconColor = Colors.white;
    } else {
      circleColor = Colors.grey[300]!;
      iconColor = Colors.grey[500]!;
    }

    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        Container(
          width: 36,
          height: 36,
          decoration: BoxDecoration(
            color: circleColor,
            shape: BoxShape.circle,
          ),
          child: Icon(
            step.isCompleted ? Icons.check : step.icon,
            color: iconColor,
            size: 18,
          ),
        ),
        const SizedBox(height: 6),
        Text(
          step.label,
          style: TextStyle(
            fontSize: 11,
            fontWeight: step.isCurrent ? FontWeight.bold : FontWeight.normal,
            color: step.isCompleted || step.isCurrent
                ? AppColors.textPrimary
                : AppColors.textHint,
          ),
          textAlign: TextAlign.center,
        ),
        const SizedBox(height: 2),
        Text(
          '+${step.xp} XP',
          style: TextStyle(
            fontSize: 10,
            color: step.isCompleted
                ? AppColors.statusDiscovered
                : AppColors.textHint,
            fontWeight: FontWeight.w500,
          ),
        ),
      ],
    );
  }

