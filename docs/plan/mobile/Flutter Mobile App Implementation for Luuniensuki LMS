    Rank(level: 8, name: 'Hoàng Đế', xp: 2800),
    Rank(level: 9, name: 'Sử Quan', xp: 3600),
  ];

  /// Get rank for a given XP value
  static Rank forXp(int xp) {
    Rank current = defaultRanks.first;
    for (final rank in defaultRanks) {
