# Janus HTTP transport — signaling HTTP API (:8088) + admin API (:7088).
# Both bound to the internal docker network only (see docker-compose).
general: {
    json = "indented"
    base_path = "/janus"
    http = true
    port = 8088
    https = false
}

admin: {
    admin_base_path = "/admin"
    admin_http = true
    admin_port = 7088
    admin_https = false
}
