# Janus core configuration — live-room-rust-janus-migration.
# Minimal config for a single-node VideoRoom SFU fronted by the Rust signaling
# broker. Admin/signaling ports stay on the internal docker network; only the
# media UDP range and the reverse-proxied WS path are reachable externally.

general: {
    configs_folder = "/opt/janus/etc/janus"
    plugins_folder = "/opt/janus/lib/janus/plugins"
    transports_folder = "/opt/janus/lib/janus/transports"
    # Keep logs modest on the disk-constrained host.
    debug_level = 4
    admin_secret = "REPLACE_JANUS_ADMIN_SECRET"
    # API secret guards the signaling API (broker supplies it server-side).
    api_secret = "REPLACE_JANUS_API_SECRET"
    # We gate authorization at the Rust layer; no token auth here.
    token_auth = false
}

media: {
    # RTP media UDP range — must match the docker-compose port mapping and be
    # non-overlapping with LiveKit's 50000-50100 range.
    rtp_port_range = "20000-20100"
    # Bound DTLS/SRTP work; defaults are fine for a single node.
    ipv6 = false
}

nat: {
    # ICE: rely on host/srflx + the existing coturn TURN deployment. The browser
    # receives short-lived TURN credentials from the Rust credential service.
    ice_lite = false
    ice_tcp = false
    # nice_debug = false
    # turn_server / turn_port are provided to clients via ICE creds, not here.
}

plugins: {
    # Only the VideoRoom plugin is needed for the classroom SFU.
    disable = "libjanus_audiobridge.so,libjanus_streaming.so,libjanus_voicemail.so,libjanus_textroom.so,libjanus_recordplay.so,libjanus_sip.so,libjanus_nosip.so,libjanus_echotest.so,libjanus_videocall.so"
}

transports: {
    # Only WebSocket + HTTP (admin) transports; disable the rest.
    disable = "libjanus_rabbitmq.so,libjanus_mqtt.so,libjanus_nanomsg.so,libjanus_pfunix.so"
}
