# VideoRoom plugin configuration — live-room-rust-janus-migration.
#
# Rooms are created dynamically by the Rust Janus admin client (one VideoRoom per
# live session, keyed by a numeric janus_room_id and a per-room secret). No
# static rooms are defined here; the `general` block only sets safe defaults.

general: {
    # Admin key required to create/destroy rooms via the API. The Rust
    # JanusAdminClient supplies this; it is never sent to browsers.
    admin_key = "REPLACE_JANUS_ADMIN_SECRET"
    # Emit "joining" events so the broker can track the roster.
    # (Per-room options like publishers/bitrate/audiolevel_event are set at
    #  create time by the Rust admin client.)
    lock_rtp_forwarders = true
}
