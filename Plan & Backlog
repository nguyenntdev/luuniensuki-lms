_at=now,\n   549\t                )\n   550\t            )\n   551\t        else:\n   552\t            progress.status = \"completed\"\n   553\t            progress.completed_at = progress.completed_at or now\n   554\t\n   555\t    return xp_awarded, badges_awarded, certificate\n   556\t\n   557\t\n   558\tdef _count_user_discoveries(session: Session, user_id) -> tuple[int, int]:\n   559\t    \"\"\"Returns (total_discovered_motifs, distinct_urns_with_discoveries)\"\"\"\n   560\t    from sqlalchemy import distinct, func\n   561\t\n   562\t    discovered = session.execute(\n   563\t        select(func.count(UserProgress.id)).where(\n   564\t            UserProgress.user_id == user_id, UserProgress.status != UnlockStatus.hidden\n   565\t        )\n   566\t    ).scalar_one()\n   567\t    urns = session.execute(\n   568\t        select(func.count(distinct(Motif.urn_id)))\n   569\t        .select_from(UserProgress)\n   570\t        .join(Motif, UserProgress.motif_id == Motif.id)\n   571\t        .where(\n   572\t            UserProgress.user_id == user_id, UserProgress.status != UnlockStatus.hidden\n   573\t        )\n   574\t    ).scalar_one()\n   575\t    return discovered, urns\n   576\t\n   577\t\n   578\tdef _cookie_params() -> dict[str, Any]:\n   579\t    samesite = (settings.cookie_samesite or \"lax\").lower()\n   580\t    if samesite not in {\"lax\", \"strict\", \"none\"}:\n   581\t        samesite = \"lax\"\n   582\t    params: dict[str, Any] = {\n   583\t        \"secure\": settings.cookie_secure,\n   584\t        \"samesite\": samesite,\n   585\t        \"path\": settings.cookie_path,\n   586\t    }\n   587\t    if settings.cookie_domain:\n   588\t        params[\"domain\"] = settings.cookie_domain\n   589\t    return params\n   590\t\n   591\t\n   592\tdef _set_auth_cookies(\n   593\t    response: Response, *, access_token: str, refresh_token: str\n   594\t) -> None:\n   595\t    params = _cookie_params()\n   596\t    access_max_age = int(settings.access_token_expire_minutes) * 60\n   597\t    refresh_max_age = int(settings.refresh_token_expire_days) * 24 * 60 * 60\n   598\t    response.set_cookie(\n   599\t        settings.access_cookie_name,\n   600\t        access_token,\n   601\t        max_age=access_max_age,\n   602\t        httponly=True,\n   603\t        **params,\n   604\t    )\n   605\t    response.set_cookie(\n   606\t        settings.refresh_cookie_name,\n   607\t        refresh_token,\n   608\t        max_age=refresh_max_age,\n   609\t        httponly=True,\n   610\t        **params,\n   611\t    )\n   612\t\n   613\t\n   614\tdef _clear_auth_cookies(response: Response) -> None:\n   615\t    params = _cookie_params()\n   616\t    response.delete_cookie(settings.access_cookie_name, **params)\n   617\t    response.delete_cookie(settings.refresh_cookie_name, **params)\n   618\t\n   619\t\n   620\tdef get_current_user(\n   621\t    request: Request,\n   622\t    token: Optional[str] = Depends(oauth2_scheme),\n   623\t    db: Session = Depends(get_db),\n   624\t) -> User:\n   625\t    credentials_exception = HTTPException(\n   626\t        status_code=status.HTTP_401_UNAUTHORIZED,\n   627\t        detail=\"Could not validate credentials\",\n   628\t        headers={\"WWW-Authenticate\": \"Bearer\"},\n   629\t    )\n   630\t\n   631\t    raw_token = token or request.cookies.get(settings.access_cookie_name)\n   632\t    if not raw_token:\n   633\t        raise credentials_exception\n   634\t\n   635\t    try:\n   636\t        payload = jwt.decode(\n   637\t            raw_token, settings.jwt_secret_key, algorithms=[settings.jwt_algorithm]\n   638\t        )\n   639\t        subject = payload.get(\"sub\")\n   640\t        token_type = payload.get(\"type\")\n   641\t        if not subject or token_type != \"access\":\n   642\t            raise credentials_exception\n   643\t        user_id = UUID(subject)\n   644\t    except (JWTError, ValueError):\n   645\t        raise credentials_exception\n   646\t\n   647\t    user = db.get(User, user_id)\n   648\t    if user is None:\n   649\t        raise credentials_exception\n   650\t    return user\n   651\t\n   652\t\n   653\tdef _can_view_drafts(user: User) -> bool:\n   654\t    return user.role in STAFF_ROLES\n   655\t\n   656\t\n   657\tdef _require_roles(roles: set[UserRole]):\n   658\t    def _dependency(current_user: User = Depends(get_current_user)) -> User:\n   659\t        if current_user.role not in roles:\n   660\t            raise HTTPException(\n   661\t                status_code=status.HTTP_403_FORBIDDEN, detail=\"Not authorized\"\n   662\t            )\n   663\t        return current_user\n   664\t\n   665\t    return _dependency\n   666\t\n   667\t\n   668\tdef get_staff_user(current_user: User = Depends(get_current_user)) -> User:\n   669\t    if current_user.role not in STAFF_ROLES:\n   670\t        raise HTTPException(status_code=403, detail=\"Not authorized\")\n   671\t    return current_user\n   672\t\n   673\t\n   674\tdef get_admin_user(current_user: User = Depends(get_current_user)) -> User:\n   675\t    if current_user.role not in ADMIN_ROLES:\n   676\t        raise HTTPException(status_code=403, detail=\"Not authorized\")\n   677\t    return current_user\n   678\t\n   679\t\n   680\tclass UserOut(BaseModel):\n   681\t    model_config = ConfigDict(from_attributes=True)\n   682\t\n   683\t    id: UUID\n   684\t    email: str\n   685\t    display_name: str\n   686\t    avatar_url: Optional[str] = None\n   687\t    username: Optional[str] = None\n   688\t    role: str\n   689\t    total_xp: int\n   690\t    starting_urn_id: Optional[UUID] = None\n   691\t    is_profile_public: bool\n   692\t    ai_personalization_enabled: bool\n   693\t\n   694\t\n   695\tclass RankOut(BaseModel):\n   696\t    level: int\n   697\t    name: str\n   698\t    xp: int\n   699\t\n   700\t\n   701\tclass UserStatsOut(BaseModel):\n   702\t    total_xp: int\n   703\t    rank: RankOut\n   704\t    xp_to_next_rank: int\n   705\t    next_rank: Optional[RankOut] = None\n   706\t\n   707\t\n   708\tclass AuthMeResponse(BaseModel):\n   709\t    user: UserOut\n   710\t    stats: UserStatsOut\n   711\t\n   712\t\n   713\tdef _build_auth_me_response(user: User) -> AuthMeResponse:\n   714\t    current_rank, next_rank, xp_to_next = _compute_rank(user.total_xp)\n   715\t    return AuthMeResponse(\n   716\t        user=UserOut(\n   717\t            id=user.id,\n   718\t            email=user.email,\n   719\t            display_name=user.display_name,\n   720\t            avatar_url=user.avatar_url,\n   721\t            username=user.username,\n   722\t            role=user.role.value,\n   723\t            total_xp=user.total_xp,\n   724\t            starting_urn_id=user.starting_urn_id,\n   725\t            is_profile_public=user.is_profile_public,\n   726\t            ai_personalization_enabled=user.ai_personalization_enabled,\n   727\t        ),\n   728\t        stats=UserStatsOut(\n   729\t            total_xp=user.total_xp,\n   730\t            rank=RankOut(**current_rank),\n   731\t            xp_to_next_rank=xp_to_next,\n   732\t            next_rank=(RankOut(**next_rank) if next_rank else None),\n   733\t        ),\n   734\t    )\n   735\t\n   736\t\n   737\tclass AuthRegisterRequest(BaseModel):\n   738\t    email: EmailStr\n   739\t    password: str = Field(min_length=8, max_length=72)\n   740\t    display_name: str = Field(min_length=1, max_length=100)\n   741\t\n   742\t\n   743\tclass AuthLoginRequest(BaseModel):\n   744\t    email: EmailStr\n   745\t    password: str = Field(min_length=1, max_length=72)\n   746\t\n   747\t\n   748\tclass ChangePasswordRequest(BaseModel):\n   749\t    current_password: str\n   750\t    new_password: str = Field(..., min_length=8)\n   751\t\n   752\t\n   753\t@app.post(\n   754\t    \"/api/v1/auth/register\",\n   755\t    response_model=AuthMeResponse,\n   756\t    status_code=status.HTTP_201_CREATED,\n   757\t)\n   758\tdef register(\n   759\t    payload: AuthRegisterRequest,\n   760\t    response: Response,\n   761\t    db: Session = Depends(get_db),\n   762\t) -> AuthMeResponse:\n   763\t    existing = db.execute(\n   764\t        select(User).where(User.email == str(payload.email))\n   765\t    ).scalar_one_or_none()\n   766\t    if existing is not None:\n   767\t        raise AppError(\n   768\t            code=\"EMAIL_ALREADY_REGISTERED\",\n   769\t            message=\"Email already registered\",\n   770\t            status_code=status.HTTP_409_CONFLICT,\n   771\t        )\n   772\t\n   773\t    user = User(\n   774\t        email=str(payload.email),\n   775\t        password_hash=\"\",\n   776\t        display_name=payload.display_name,\n   777\t    )\n   778\t    try:\n   779\t        user.password_hash = hash_password(payload.password)\n   780\t    except ValueError:\n   781\t        raise AppError(\n   782\t            code=\"PASSWORD_TOO_LONG\",\n   783\t            message=\"Password too long\",\n   784\t            status_code=status.HTTP_400_BAD_REQUEST,\n   785\t        )\n   786\t    db.add(user)\n   787\t    try:\n   788\t        db.commit()\n   789\t    except IntegrityError:\n   790\t        db.rollback()\n   791\t        raise AppError(\n   792\t            code=\"EMAIL_ALREADY_REGISTERED\",\n   793\t            message=\"Email already registered\",\n   794\t            status_code=status.HTTP_409_CONFLICT,\n   795\t        )\n   796\t\n   797\t    db.refresh(user)\n   798\t\n   799\t    access_token = create_jwt_token(\n   800\t        subject=str(user.id),\n   801\t        secret_key=settings.jwt_secret_key,\n   802\t        algorithm=settings.jwt_algorithm,\n   803\t        expires_delta=timedelta(minutes=settings.access_token_expire_minutes),\n   804\t        extra_claims={\"type\": \"access\"},\n   805\t    )\n   806\t    refresh_token = create_jwt_token(\n   807\t        subject=str(user.id),\n   808\t        secret_key=settings.jwt_secret_key,\n   809\t        algorithm=settings.jwt_algorithm,\n   810\t        expires_delta=timedelta(days=settings.refresh_token_expire_days),\n   811\t        extra_claims={\"type\": \"refresh\"},\n   812\t    )\n   813\t\n   814\t    _set_auth_cookies(response, access_token=access_token, refresh_token=refresh_token)\n   815\t    response.headers[\"Cache-Control\"] = \"no-store\"\n   816\t    return _build_auth_me_response(user)\n   817\t\n   818\t\n   819\t@app.post(\"/api/v1/auth/login\", response_model=AuthMeResponse)\n   820\tdef login(\n   821\t    payload: AuthLoginRequest, response: Response, db: Session = Depends(get_db)\n   822\t) -> AuthMeResponse:\n   823\t    user = db.execute(\n   824\t        select(User).where(User.email == str(payload.email))\n   825\t    ).scalar_one_or_none()\n   826\t    if user is None or not verify_password(payload.password, user.password_hash):\n   827\t        raise AppError(\n   828\t            code=\"INVALID_CREDENTIALS\",\n   829\t            message=\"Invalid email or password\",\n   830\t            status_code=status.HTTP_401_UNAUTHORIZED,\n   831\t        )\n   832\t\n   833\t    access_token = create_jwt_token(\n   834\t        subject=str(user.id),\n   835\t        secret_key=settings.jwt_secret_key,\n   836\t        algorithm=settings.jwt_algorithm,\n   837\t        expires_delta=timedelta(minutes=settings.access_token_expire_minutes),\n   838\t        extra_claims={\"type\": \"access\"},\n   839\t    )\n   840\t    refresh_token = create_jwt_token(\n   841\t        subject=str(user.id),\n   842\t        secret_key=settings.jwt_secret_key,\n   843\t        algorithm=settings.jwt_algorithm,\n   844\t        expires_delta=timedelta(days=settings.refresh_token_expire_days),\n   845\t        extra_claims={\"type\": \"refresh\"},\n   846\t    )\n   847\t\n   848\t    _set_auth_cookies(response, access_token=access_token, refresh_token=refresh_token)\n   849\t    response.headers[\"Cache-Control\"] = \"no-store\"\n   850\t    return _build_auth_me_response(user)\n   851\t\n   852\t\n   853\t@app.get(\"/api/v1/auth/me\", response_model=AuthMeResponse)\n   854\tdef me(current_user: User = Depends(get_current_user)) -> AuthMeResponse:\n   855\t    return _build_auth_me_response(current_user)\n   856\t\n   857\t\n   858\t@app.post(\"/api/v1/auth/refresh\", response_model=AuthMeResponse)\n   859\tdef refresh_session(\n   860\t    request: Request, response: Response, db: Session = Depends(get_db)\n   861\t) -> AuthMeResponse:\n   862\t    credentials_exception = HTTPException(\n   863\t        status_code=status.HTTP_401_UNAUTHORIZED,\n   864\t        detail=\"Could not validate credentials\",\n   865\t        headers={\"WWW-Authenticate\": \"Bearer\"},\n   866\t    )\n   867\t\n   868\t    raw_token = request.cookies.get(settings.refresh_cookie_name)\n   869\t    if not raw_token:\n   870\t        raise credentials_exception\n   871\t\n   872\t    try:\n   873\t        payload = jwt.decode(\n   874\t            raw_token, settings.jwt_secret_key, algorithms=[settings.jwt_algorithm]\n   875\t        )\n   876\t        subject = payload.get(\"sub\")\n   877\t        token_type = payload.get(\"type\")\n   878\t        if not subject or token_type != \"refresh\":\n   879\t            raise credentials_exception\n   880\t        user_id = UUID(subject)\n   881\t    except (JWTError, ValueError):\n   882\t        raise credentials_exception\n   883\t\n   884\t    user = db.get(User, user_id)\n   885\t    if user is None:\n   886\t        raise credentials_exception\n   887\t\n   888\t    access_token = create_jwt_token(\n   889\t        subject=str(user.id),\n   890\t        secret_key=settings.jwt_secret_key,\n   891\t        algorithm=settings.jwt_algorithm,\n   892\t        expires_delta=timedelta(minutes=settings.access_token_expire_minutes),\n   893\t        extra_claims={\"type\": \"access\"},\n   894\t    )\n   895\t    refresh_token = create_jwt_token(\n   896\t        subject=str(user.id),\n   897\t        secret_key=settings.jwt_secret_key,\n   