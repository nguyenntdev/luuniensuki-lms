 character == \" \":\n   948\t            continue\n   949\t        if \"0\" <= character <= \"9\":\n   950\t            continue\n   951\t        if unicodedata.category(character).startswith(\n   952\t            \"L\"\n   953\t        ) and \"LATIN\" in unicodedata.name(character, \"\"):\n   954\t            continue\n   955\t        return False\n   956\t    return True\n   957\t\n   958\t\n   959\t@app.patch(\"/api/v1/users/me\", response_model=UpdateProfileResponse)\n   960\tdef update_profile(\n   961\t    request: UpdateProfileRequest,\n   962\t    current_user: User = Depends(get_current_user),\n   963\t    db: Session = Depends(get_db),\n   964\t) -> UpdateProfileResponse:\n   965\t    if request.display_name is not None:\n   966\t        normalized_display_name = unicodedata.normalize(\"NFC\", request.display_name)\n   967\t        if not _is_valid_display_name(normalized_display_name):\n   968\t            raise AppError(\n   969\t                code=\"INVALID_DISPLAY_NAME\",\n   970\t                message=\"Display name must contain only letters, numbers, and spaces\",\n   971\t                status_code=status.HTTP_400_BAD_REQUEST,\n   972\t            )\n   973\t        current_user.display_name = normalized_display_name\n   974\t\n   975\t    if request.username is not None:\n   976\t        if not USERNAME_REGEX.fullmatch(request.username):\n   977\t            raise AppError(\n   978\t                code=\"INVALID_USERNAME\",\n   979\t                message=\"Username must be 3-20 characters and contain only letters, numbers, and underscores\",\n   980\t                status_code=status.HTTP_400_BAD_REQUEST,\n   981\t            )\n   982\t\n   983\t        existing_user_id = db.execute(\n   984\t            select(User.id).where(\n   985\t                User.username == request.username, User.id != current_user.id\n   986\t            )\n   987\t        ).scalar_one_or_none()\n   988\t        if existing_user_id is not None:\n   989\t     