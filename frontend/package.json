{
  "name": "cuudinhky-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "npm run type-check",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "type-check": "tsc --noEmit",
    "gen:api": "openapi-typescript ${OPENAPI_SCHEMA:-$NEXT_PUBLIC_API_BASE_URL/openapi.json} -o src/types/api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint .",
    "lint:ci": "ESLINT_USE_FLAT_CONFIG=true eslint . --max-warnings=0 --exit-on-fatal-error --report-unused-disable-directives"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "livekit-client": "^2.18.3",
    "lucide-react": "^0.561.0",
    "next": "^15.0.0",
    "qrcode.react": "^3.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.9",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.41",
    "shadcn": "^4.4.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
