            xp_awarded = max(xp_awarded, delta)
        _update_streak(user, now)
        if was_locked and int(discovered_before or 0) == 0:
            badge_bonus += _award_badge(db, user=user, badge_slug=BADGE_FIRST_DISCOVERY)
        if user.current_streak >= 7:
